---
/**
 * Lesson page shell.
 *
 * Five slots, in order, and only two of them are written in MDX:
 *
 *   position   breadcrumb + "Step 4 of 25", so the reader knows where they are
 *   goal       title + description + "What you'll learn" + time + prerequisites
 *   body       the MDX (Why + How) — the author writes this
 *   practice   rendered from frontmatter, so no lesson can end without a handoff
 *   next       the pager
 *
 * The prose rules below are the other half of the fix. `.prose` used to style
 * h2/h3/p/ul/ol/li/strong/code and *nothing else* — no img, figure, table or
 * link rule — so a lesson diagram was a bare `display: inline` 60px stamp at
 * the left edge of an 820px column and the Dot/Hook/Line recognition table
 * rendered 214px wide with 1px cell padding. Pictures now come in through
 * <Figure>, which frames and captions them; everything here is the safety net
 * for what markdown itself emits.
 */
import { getCollection } from "astro:content";
import Base from "./Base.astro";
import Header from "../components/Header.astro";
import JumpBar from "../components/JumpBar.astro";
import Page from "../components/Page.astro";
import ProgressBar from "../components/ProgressBar.astro";
import LessonMeta from "../components/LessonMeta.astro";
import { phaseAnchor, phaseName } from "../data/phases";
import { caseById } from "../data/algs";
import { TRAINER_GROUPS } from "../lib/trainer";

interface PracticeLink {
  href: string;
  label: string;
}
interface Practice {
  groups: string[];
  links: PracticeLink[];
  note: string;
}

interface Props {
  id: string;
  title: string;
  description: string;
  phase: string;
  order: number;
  minutes: number;
  objectives: string[];
  prerequisites: string[];
  algorithms: string[];
  practice: Practice;
  /** Astro's own `render().headings`, passed through by learn/[...slug].astro. */
  headings?: { depth: number; slug: string; text: string }[];
}

const {
  id,
  title,
  description,
  phase,
  minutes,
  objectives,
  prerequisites,
  algorithms,
  practice,
  headings = [],
} = Astro.props;

const all = (await getCollection("lessons")).sort((a, b) => a.data.order - b.data.order);
const byId = new Map(all.map((l) => [l.id, l]));
const idx = all.findIndex((l) => l.id === id);
const step = idx + 1;
const prev = idx > 0 ? all[idx - 1] : undefined;
const next = idx >= 0 && idx < all.length - 1 ? all[idx + 1] : undefined;

// Cross-references are validated here rather than in the Zod schema, which
// cannot see the other lessons or the case data. This runs once per lesson at
// build time, so a typo in `prerequisites`, `algorithms` or `practice.groups`
// fails `astro build` instead of shipping a dead chip or a link to a trainer
// set that does not exist.
const groupKeys = new Set(TRAINER_GROUPS.map((g) => g.key));
for (const p of prerequisites) {
  if (!byId.has(p)) throw new Error(`${id}: unknown prerequisite lesson "${p}"`);
}
for (const a of algorithms) {
  if (!caseById.has(a)) throw new Error(`${id}: unknown case id "${a}" in algorithms`);
}
for (const g of practice.groups) {
  if (!groupKeys.has(g)) throw new Error(`${id}: unknown trainer group "${g}"`);
}

const prereqs = prerequisites.map((p) => byId.get(p)!);
/**
 * A trainer group key is ALSO a /reference section id — the two lists are the
 * same eleven strings — so a lesson can link to the set it teaches without a
 * line of new data. Locked sets cannot reach here: TRAINER_GROUPS is already
 * filtered through `isLocked`, and the validation loop above throws on a lesson
 * that names a group outside it, so `444-oll` and `444-pll` fail the build
 * rather than shipping a dead fragment.
 */
const drills = practice.groups.map((key) => ({
  key,
  name: TRAINER_GROUPS.find((g) => g.key === key)!.name,
  // No isLocked() guard here: TRAINER_GROUPS is already filtered by it, and the
  // loop above throws on a lesson naming a group that is not in it — so a
  // locked group cannot reach this line, and a guard would be dead code
  // claiming to protect against something that already fails the build.
  reference: `/reference/#${key}`,
}));

/** The cases this lesson teaches, as pages. Build-validated above. */
const taught = algorithms.map((a) => caseById.get(a)!);

/** The rest of this phase — a lesson could reach two others before this. */
const siblings = all.filter((l) => l.data.phase === phase);
const inPhase = siblings.findIndex((l) => l.id === id) + 1;

/**
 * The outline for the jump bar: this page's own landmarks, in document order.
 *
 * The LAYOUT's three headings bracket the body's, and including them is what
 * makes the bar universal rather than conditional. Body headings alone would
 * have given three lessons fewer than three chips, and a navigation aid that
 * appears on 22 of 25 pages is a rule the reader has to learn; "What you'll
 * learn" (all 25) and "Practice" (all 25) mean every lesson gets at least
 * three, so the bar is simply always there.
 *
 * Depth 2 only. The deepest lesson has 16 headings and a chip strip that lists
 * every h3 stops being a summary — `full-oll-overview` alone would contribute
 * nine of them, all subdivisions of two h2s already in the list.
 *
 * `headings` is Astro's own, so the slugs here are the ids actually emitted
 * into the page rather than a second slugging of the same text. Six shipped
 * heading ids begin with a digit ("1-build-the-white-cross…"): those are legal
 * URL fragments and ILLEGAL `querySelector` arguments, which is the same trap
 * `phaseAnchor()` exists for one level up. Nothing here may look them up with
 * a selector.
 */
const outline = [
  { id: "objectives-heading", label: "Overview" },
  ...headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, label: h.text })),
  ...(taught.length > 0 ? [{ id: "taught-heading", label: "Cases" }] : []),
  { id: "practice-heading", label: "Practice" },
];
---

<Base title={`${title} — Cubepath`} description={description}>
  <Header active="learn">
    <JumpBar slot="pagenav" items={outline} label="On this page" />
  </Header>
  <Page>
    <div class="lesson-head">
      {
        /*
        "Learn", not "3×3 course". One destination had three names — "Learn" in
        the header, "3×3 course" here, "Speedcubing from zero" in its own h1 —
        and on the six 4×4 and 5×5 lessons the crumb read "3×3 course › 4×4",
        mis-describing the page's own container, which is the single job a
        breadcrumb has. case/[...id].astro already names its parent the way the
        header does; this follows it.

        The phase segment is a link now. It was inert text because there was
        nothing to link to: the course index shipped no phase ids at all.
      */
      }
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Learn</a>
        <span class="sep" aria-hidden="true">›</span>
        <a href={`/#${phaseAnchor(phase)}`}>{phaseName(phase)}</a>
      </nav>
      {
        /*
        Position within the PHASE, with the global step demoted to text beside
        it. "Step 12 of 25" answered a question nobody asks — a reader coming
        back wants to know how much of the phase they are in is left, and a bar
        filled to 48% of the whole course reads as completion rather than
        position.
      */
      }
      <div class="position">
        <ProgressBar
          label={`${inPhase} of ${siblings.length} in ${phaseName(phase)}`}
          value={inPhase}
          max={siblings.length}
          count={false}
        />
        <span class="hint step">Step {step} of {all.length}</span>
      </div>
    </div>

    <h1>{title}</h1>
    <p class="lead">{description}</p>

    <div class="meta">
      <span class="chip chip--ghost">≈ {minutes} min</span>
      {
        prereqs.map((p) => (
          <a class="chip" href={`/learn/${p.id}/`}>
            After: {p.data.title}
          </a>
        ))
      }
    </div>

    {
      /*
      The *write* half of the course progress layer, and the reason the ✓ marks,
      the per-phase bars and the Resume CTA on index.astro have anything to
      read. It has two writers — the [data-lesson-end] sentinel below, and the
      exits tagged data-lesson-advance — because for a long time the pager click
      was the only one, and a reader who left by this page's own filled "Drill"
      button was never credited. `position` is off: the phase bar above already
      says where they are. Renders nothing and occupies no space until the
      lesson has actually been completed.
    */
    }
    <LessonMeta id={id} />

    <section class="objectives card" aria-labelledby="objectives-heading">
      <h2 id="objectives-heading" class="label">What you'll learn</h2>
      <ul>
        {objectives.map((o) => <li>{o}</li>)}
      </ul>
    </section>

    <article class="prose">
      <slot />
    </article>

    {
      /*
      The lesson's own cases, as pages.

      `algorithms` is a required frontmatter array of real case ids, validated
      against caseById at build time above — and it was rendered NOWHERE. 37
      ids across 8 lessons, checked on every build so a typo failed it, and not
      one of them reachable by a reader.
    */
    }
    {
      taught.length > 0 && (
        <section class="taught" aria-labelledby="taught-heading">
          <h2 id="taught-heading" class="label">
            Cases in this lesson
          </h2>
          <ul>
            {taught.map((k) => (
              <li>
                <a href={`/case/${k.id}/`}>{k.name}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {/* Writer 1's target — see LessonMeta.astro. Renders nothing. */}
    <div data-lesson-end aria-hidden="true"></div>

    <section class="practice card" aria-labelledby="practice-heading">
      <h2 id="practice-heading">Practice</h2>
      <p>{practice.note}</p>
      <div class="actions">
        {
          drills.map((d) => (
            <a class="btn btn--primary" href={`/practice/?group=${d.key}`} data-lesson-advance>
              Drill {d.name}
            </a>
          ))
        }
        {
          /*
          The same set, laid out rather than quizzed. A trainer group key IS a
          /reference section id, so this costs no new data — and until now a
          lesson's only onward link was a quiz, so a reader who wanted to SEE
          all 21 perms went to the header and landed at the top of a 9,000px
          page to hunt for the section by hand.
        */
        }
        {
          drills
            .filter((d) => d.reference !== null)
            .map((d) => (
              <a class="btn" href={d.reference!}>
                See all {d.name}
              </a>
            ))
        }
        {
          practice.links.map((l) => (
            <a
              class="btn"
              href={l.href}
              {...(l.href.startsWith("/practice/") || l.href.startsWith("/learn/")
                ? { "data-lesson-advance": "" }
                : {})}
            >
              {l.label}
            </a>
          ))
        }
      </div>
    </section>

    {
      /*
      The rest of this phase. Before this, a lesson could reach exactly two
      other lessons — the one before and the one after — so a reader who wanted
      a sibling went back to "/" and scrolled a 5,100px ladder.
    */
    }
    {
      siblings.length > 1 && (
        <nav class="phase-nav" aria-label={phaseName(phase)}>
          <span class="label">{phaseName(phase)}</span>
          <ul>
            {siblings.map((l) => (
              <li>
                <a href={`/learn/${l.id}/`} {...(l.id === id ? { "aria-current": "page" } : {})}>
                  {l.data.title}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <nav class="pager" aria-label="Lesson">
      {
        prev ? (
          <a class="pager-link" href={`/learn/${prev.id}/`}>
            <span class="dir">← Previous</span>
            <span class="what">{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a class="pager-link next" href={`/learn/${next.id}/`}>
            {/* The pager walks out of a phase — and out of the 3×3 course into
                the big cubes — with no signal at all. Name the destination
                phase when it changes, so "Next" is never a surprise. */}
            <span class="dir">
              {next.data.phase === phase ? "Next →" : `Next phase → ${phaseName(next.data.phase)}`}
            </span>
            <span class="what">{next.data.title}</span>
          </a>
        ) : (
          <a class="pager-link next" href="/">
            <span class="dir">Done →</span>
            <span class="what">Course overview</span>
          </a>
        )
      }
    </nav>
  </Page>
</Base>

<style>
  /* --- position + goal ---------------------------------------------------- */

  .lesson-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
  }
  .crumbs {
    margin-bottom: 0;
  }
  .sep {
    color: var(--faint);
  }
  .position {
    flex: 0 1 200px;
    display: grid;
    gap: 2px;
    justify-items: end;
  }
  .step {
    font-variant-numeric: tabular-nums;
  }

  /* The cases this lesson teaches. A plain list of links, not chips: .chip is
     --soft, which is a weak affordance for a row of destinations. */
  .taught {
    margin: var(--space-6) 0 0;
  }
  .taught ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }
  .taught a {
    font-weight: 600;
  }

  /* The rest of the phase, above the pager. */
  .phase-nav {
    margin: var(--space-6) 0 0;
    padding: var(--space-4) 0 0;
    border-top: 1px solid var(--line);
  }
  .phase-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }
  .phase-nav a {
    font-weight: 600;
    overflow-wrap: break-word;
  }
  /* You are here: the current lesson is named but is not a destination. */
  .phase-nav a[aria-current="page"] {
    color: var(--soft);
    text-decoration: none;
    cursor: default;
  }

  h1 {
    margin: var(--space-4) 0 0;
  }
  .lead {
    margin: var(--space-2) 0 0;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
  }

  .objectives {
    margin: var(--space-5) 0 var(--space-6);
    padding: var(--space-4) var(--space-5);
  }
  .objectives ul {
    margin: var(--space-2) 0 0;
    padding-left: var(--space-5);
  }
  .objectives li {
    margin: var(--space-1) 0;
  }

  /* --- the MDX body ------------------------------------------------------- */

  .prose {
    /* A long algorithm string or a URL must not push the column sideways. */
    overflow-wrap: break-word;
  }
  .prose :global(h2) {
    margin: var(--space-6) 0 var(--space-3);
  }
  .prose :global(h3) {
    margin: var(--space-5) 0 var(--space-2);
  }
  .prose :global(p) {
    margin: var(--space-3) 0;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: var(--space-5);
  }
  .prose :global(li) {
    margin: var(--space-1) 0;
  }
  .prose :global(strong) {
    font-weight: 600;
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.92em;
    background: var(--accent-soft);
    padding: 1px 5px;
    border-radius: var(--r-sm);
  }

  /* Safety net. Every deliberate picture goes through <Figure>; this is what
     catches a markdown `![alt](src)` or a hand-written <img> so that it can
     never again render as a 60px inline stamp with no max-width. */
  .prose :global(img) {
    display: block;
    max-inline-size: 100%;
    block-size: auto;
    margin: var(--space-5) 0;
  }
  /* …but never inside a <Figure>: the frame owns that spacing, and the rule
     above would otherwise push 24px of air between the border and the image. */
  .prose :global(figure img) {
    margin: 0;
  }

  /* Markdown tables. There were no table rules at all, so the Dot/Hook/Line
     recognition table — the single most important visual of Step 4 — rendered
     214px wide with 1px cell padding and no separators. */
  .prose :global(table) {
    inline-size: 100%;
    border-collapse: collapse;
    margin: var(--space-5) 0;
  }
  .prose :global(th),
  .prose :global(td) {
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  .prose :global(thead th) {
    font-size: var(--text-sm);
    color: var(--soft);
  }
  .prose :global(tbody tr:last-child td) {
    border-bottom: 0;
  }

  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--line);
    margin: var(--space-6) 0;
  }
  .prose :global(blockquote) {
    margin: var(--space-5) 0;
    padding-left: var(--space-4);
    border-left: 3px solid var(--line);
    color: var(--soft);
  }
  .prose :global(.case-list) {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    overflow: hidden;
    margin: var(--space-4) 0;
  }

  /* --- practice + next ---------------------------------------------------- */

  .practice {
    margin: var(--space-7) 0 0;
    padding: var(--space-4) var(--space-5) var(--space-5);
  }
  .practice p {
    margin: var(--space-2) 0 var(--space-4);
    color: var(--soft);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .actions .btn {
    text-decoration: none;
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .pager-link {
    display: grid;
    gap: 2px;
    max-inline-size: 46%;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    color: var(--ink);
  }
  .pager-link:hover {
    text-decoration: none;
    border-color: var(--accent);
  }
  .pager-link .dir {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--faint);
  }
  .pager-link .what {
    font-weight: 600;
  }
  /* --on-accent, never #fff: the dark-mode accent is light, and #fff on it
     measured 2.44:1. */
  .pager-link.next {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
    text-align: right;
  }
  /* No opacity here: --on-accent at 0.75 blends toward --accent and measures
     3.87:1 in light mode, which axe flags as a serious contrast violation. The
     eyebrow is already distinguished by size, weight and letter-spacing. */
  .pager-link.next .dir {
    color: var(--on-accent);
  }

  /*
   * Phones. The way forward at the end of every lesson was a 46%-wide box
   * holding a full lesson title, so "Orient Corners: Anti-Sune + 5 New Cases"
   * wrapped to four ragged lines in the one place on the screen where the
   * thumb already is. Stack them full width instead.
   *
   * .pager-link.next keeps its class: LessonMeta.astro's documented contract
   * finds the exit as `a[data-lesson-next], a[data-lesson-advance],
   * a.pager-link.next`.
   */
  @media (max-width: 560px) {
    .pager {
      display: grid;
      /* An explicit 1fr track, because the base rule's `justify-content:
         space-between` still applies in grid and would leave a single
         max-content column sitting at 244px of a 358px row. */
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
    .pager-link {
      max-inline-size: none;
    }
    .pager-link.next {
      text-align: start;
    }
    /* The empty <span> that stands in for a missing "Previous". */
    .pager > span:empty {
      display: none;
    }
    .position {
      justify-items: start;
    }
  }
</style>
