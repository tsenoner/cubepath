<style>
  /* The bar spans the viewport; its contents share the page shell's measure
     and gutter, so the brand lines up with the content below it. */
  .site-header {
    border-bottom: 1px solid var(--line);
    background: var(--card);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 24px;
    max-width: var(--shell-max);
    margin: 0 auto;
    padding: 12px var(--shell-x);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--ink);
  }
  .brand:hover {
    text-decoration: none;
  }
  .logo {
    display: block;
    flex: none;
  }
  .logo .b {
    fill: var(--logo-body);
  }
  .logo .u {
    fill: var(--logo-u);
  }
  .logo .f {
    fill: var(--logo-f);
  }
  .logo .r {
    fill: var(--logo-r);
  }
  .logo .t {
    fill: var(--brand);
  }
  .wordmark {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 700;
  }
  nav {
    display: flex;
    gap: 18px;
  }
  .navlink {
    font-weight: 600;
    font-size: 14px;
    color: var(--soft);
  }
  .navlink.active {
    color: var(--ink);
  }
  .navlink:hover {
    text-decoration: none;
    color: var(--ink);
  }
  .spacer {
    flex-grow: 1;
  }
  .theme {
    display: grid;
    place-items: center;
    inline-size: 30px;
    block-size: 30px;
    flex: none;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: transparent;
    color: var(--soft);
    cursor: pointer;
  }
  .theme:hover {
    color: var(--ink);
  }
  /* One <svg>, three icons — only the current state's group is painted, so the
     button never reflows and there is nothing to load on a click. */
  .theme g {
    display: none;
  }
  .theme[data-state="system"] .i-system,
  .theme[data-state="light"] .i-light,
  .theme[data-state="dark"] .i-dark {
    display: inline;
  }
  .install {
    font: 600 13px var(--font-body);
    color: var(--accent);
    background: var(--accent-soft);
    border: 0;
    border-radius: 999px;
    padding: 5px 12px;
    cursor: pointer;
    flex: none;
  }

  /*
   * Phones: the bar needed 455px at a 375px viewport, so every page scrolled
   * sideways and the Install button sat off-screen. Dropping the wordmark (the
   * logo carries the brand) and tightening the gaps is most of the fix.
   *
   * A fourth destination and the theme control put it back over — measured 392
   * against a 375px viewport with Install shown — so Install leaves the bar at
   * this size. It is not lost: the home page's "Take it offline" block carries
   * the same `data-install-slot` button, with the iOS instructions beside it,
   * and PwaShell surfaces every slot at once.
   *
   * A FIFTH destination (Glossary) then needed 377px, so below 375 every page
   * scrolled sideways again and at exactly 375 the gate had no headroom left —
   * one longer label or a different font metric and CI fails. Dropping a
   * destination is not an option (each is a real surface), so the nav is a
   * side-scrolling strip on a phone, the same idiom /reference's jump bar uses:
   * `min-inline-size: 0` is what lets a flex item shrink below its content, and
   * `overflow-x` is what e2e/regressions.spec.ts reads to tell a deliberate
   * strip from a page that widened.
   */
  @media (max-width: 560px) {
    .bar {
      gap: 12px;
      padding: 10px 14px;
    }
    .wordmark {
      display: none;
    }
    nav {
      gap: 12px;
      min-inline-size: 0;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .navlink {
      font-size: 13px;
      white-space: nowrap;
    }
    .theme {
      inline-size: 28px;
      block-size: 28px;
    }
    .install {
      display: none;
    }
  }
</style>

<script>
  /*
   * Theme control — three states: system (default), light, dark.
   *
   * Why three and not a plain light/dark switch: the 130 generated cube
   * diagrams are <img>-loaded SVGs. An <img>-loaded SVG cannot see the page's
   * CSS or its `data-theme` attribute; it themes itself with its own
   * `@media (prefers-color-scheme)` block. So a two-state toggle would
   * necessarily desynchronise the diagrams from the page for every user whose
   * OS disagrees with their choice. Defaulting to "system" keeps page and
   * diagrams in step unless the reader deliberately overrides, and overriding
   * is then their explicit, reversible act rather than the app's default.
   *
   * The residual cost of an override is small and measured: of the 130 SVGs,
   * 114 are theme-independent (their only themed rule sets the background
   * plate to `fill:none`, which both media branches do), and the 16 notation
   * move diagrams carry a move letter that stays #222222 under a forced dark
   * theme. Making that letter theme-independent belongs in the generator.
   */
  type Theme = "system" | "light" | "dark";

  const KEY = "cubepath.theme";
  const ORDER: readonly Theme[] = ["system", "light", "dark"];
  const LABEL: Record<Theme, string> = {
    system: "follow system",
    light: "light",
    dark: "dark",
  };
  const CHROME: Record<"light" | "dark", string> = { light: "#fcfbf8", dark: "#161412" };

  const root = document.documentElement;

  function stored(): Theme {
    try {
      const v = localStorage.getItem(KEY);
      return v === "light" || v === "dark" ? v : "system";
    } catch {
      return "system";
    }
  }

  /** The media-less <meta name="theme-color"> that outranks the two in <head>. */
  function setChrome(theme: Theme): void {
    const existing = document.querySelector<HTMLMetaElement>("meta[data-theme-color-forced]");
    if (theme === "system") {
      existing?.remove();
      return;
    }
    const meta = existing ?? document.createElement("meta");
    meta.name = "theme-color";
    meta.setAttribute("data-theme-color-forced", "");
    meta.content = CHROME[theme];
    if (!existing) document.head.insertBefore(meta, document.head.firstChild);
  }

  function apply(theme: Theme, persist: boolean): void {
    if (theme === "system") {
      root.removeAttribute("data-theme");
      root.style.removeProperty("color-scheme");
    } else {
      root.setAttribute("data-theme", theme);
      root.style.colorScheme = theme;
    }
    setChrome(theme);
    if (persist) {
      try {
        if (theme === "system") localStorage.removeItem(KEY);
        else localStorage.setItem(KEY, theme);
      } catch {
        /* Storage denied — the choice lasts for this page only. */
      }
    }
    const nextTheme = ORDER[(ORDER.indexOf(theme) + 1) % ORDER.length] ?? "system";
    for (const btn of document.querySelectorAll<HTMLElement>("[data-theme-toggle]")) {
      btn.dataset.state = theme;
      btn.title = `Theme: ${LABEL[theme]}`;
      btn.setAttribute(
        "aria-label",
        `Theme: ${LABEL[theme]}. Activate to switch to ${LABEL[nextTheme]}.`,
      );
    }
  }

  apply(stored(), false);

  for (const btn of document.querySelectorAll<HTMLElement>("[data-theme-toggle]")) {
    btn.addEventListener("click", () => {
      const current = stored();
      apply(ORDER[(ORDER.indexOf(current) + 1) % ORDER.length] ?? "system", true);
    });
  }
</script>
