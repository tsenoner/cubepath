---
/**
 * LessonMeta — lesson completion: records it, and shows it.
 *
 *   <LessonMeta id={id} />                    (once, anywhere on a lesson page)
 *   <LessonMeta id={id} position />           (…and print "Step 4 of 25 · Phase 1")
 *
 * This is the *write* half of the course's progress layer. The home page reads
 * the `lessons` store in lib/db.ts to draw its per-phase bars, its ✓ marks and
 * its "Resume: <lesson>" button; nothing was ever writing that store. Dropping
 * this component onto a lesson page is all it takes — it finds the pager
 * itself and marks the lesson complete when the reader moves on.
 *
 * TWO WRITERS, because one was not enough.
 *
 *   1. Reaching the end of the lesson. An IntersectionObserver on the sentinel
 *      Lesson.astro renders between the body and the Practice card.
 *   2. Leaving by a link that means "I am done here" — the pager's Next, and
 *      the Practice card's drill links, found as:
 *
 *          a[data-lesson-advance]
 *
 * The last of those matches Lesson.astro's markup as it stands, so the pager
 * works with no change to that file. Add `data-lesson-next` to the next-link if
 * the class ever changes and this keeps working either way.
 *
 * WHY THE OBSERVER EXISTS. Until it did, the pager click was the ONLY call site
 * of markLessonComplete in the app. Every lesson ends with a Practice card
 * whose filled primary button says "Drill <set>" — the thing the lesson itself
 * tells the reader to do next — and taking it recorded nothing. So the reader
 * who followed the course as written got no tick, a phase bar stuck at 0/N and
 * a hero that still said "Start learning" pointed at lesson one, on every
 * return visit, forever. index.astro returns early when the store is empty, so
 * the whole progress layer was dark for them.
 *
 * The last lesson has no next lesson, but its pager still renders a "Course
 * overview →" link with the same class — so finishing the course records the
 * final lesson too.
 *
 * `position` is off by default because Lesson.astro renders its own "Step N of
 * M" bar; turn it on for a page that does not. With it off and the lesson not
 * yet finished, this component renders nothing visible and occupies no space.
 *
 * All of it is client-side: the static build is unaffected and it works
 * offline like the rest of the app.
 */
import { getCollection } from "astro:content";
import { phaseName } from "../data/phases";

interface Props {
  /** The lesson's content-collection id, i.e. its slug. */
  id: string;
  /** Also render "Step N of M · Phase". Off: Lesson.astro already shows it. */
  position?: boolean;
  class?: string;
}
const { id, position = false, class: className } = Astro.props;

const all = (await getCollection("lessons")).sort((a, b) => a.data.order - b.data.order);
const idx = all.findIndex((l) => l.id === id);
const step = idx >= 0 ? idx + 1 : 0;
const phase = idx >= 0 ? all[idx]?.data.phase : undefined;
---

<p
  class:list={["lesson-meta", { "lesson-meta--position": position }, className]}
  data-lesson-meta
  data-lesson-slug={id}
>
  {
    position && (
      <span class="step">
        Step {step} of {all.length}
      </span>
    )
  }
  {
    position && phase && (
      <span aria-hidden="true" class="sep">
        ·
      </span>
    )
  }
  {position && phase && <span>{phaseName(phase)}</span>}
  <span class="done" hidden data-lesson-done>✓ Completed</span>
</p>

<style>
  .lesson-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    /* No margin by default: with `position` off and nothing completed this
       element is empty, and an empty element must not push the page around. */
    margin: 0;
    font-size: var(--text-sm);
    color: var(--faint);
  }
  .lesson-meta--position,
  .lesson-meta:has(.done:not([hidden])) {
    margin-block-end: var(--space-3);
  }
  .step {
    font-weight: 600;
    color: var(--soft);
  }
  .done {
    font-weight: 600;
    color: var(--ok);
  }
</style>

<script>
  import { completedLessons, markLessonComplete } from "../lib/db";

  const meta = document.querySelector<HTMLElement>("[data-lesson-meta]");
  const slug = meta?.dataset.lessonSlug;

  if (meta && slug) {
    const badge = meta.querySelector<HTMLElement>("[data-lesson-done]");
    const showBadge = (): void => {
      if (badge) badge.hidden = false;
    };

    // Reflect an existing completion. A failed read is not worth a message:
    // the page is still a lesson, it just does not show the badge.
    void completedLessons()
      .then((done) => {
        if (done.has(slug)) showBadge();
      })
      .catch(() => undefined);

    let recorded = false;
    const record = (): Promise<void> => {
      if (recorded) return Promise.resolve();
      recorded = true;
      // markLessonComplete is idempotent and preserves the original
      // completedAt (db.ts), so the two writers racing is harmless.
      return markLessonComplete(slug)
        .then(showBadge)
        .catch(() => undefined);
    };

    // ── Writer 1: the reader reached the end of the lesson ──────────────
    // The sentinel sits between the body and the Practice card, so "seen" means
    // the prose is behind them. Gated on their having scrolled at least once:
    // a short lesson can render with the sentinel already in view, and
    // arriving-and-leaving is not reading. The 2s dwell is the same idea in
    // time — a fast scroll to the bottom and straight back out does not count.
    const sentinel = document.querySelector("[data-lesson-end]");
    if (sentinel && "IntersectionObserver" in window) {
      let scrolled = false;
      const onScroll = (): void => {
        scrolled = true;
      };
      window.addEventListener("scroll", onScroll, { passive: true, once: true });

      let timer = 0;
      const observer = new IntersectionObserver(
        (records) => {
          const seen = records.some((r) => r.isIntersecting) && scrolled;
          if (!seen) {
            window.clearTimeout(timer);
            timer = 0;
            return;
          }
          if (timer) return;
          timer = window.setTimeout(() => {
            observer.disconnect();
            window.removeEventListener("scroll", onScroll);
            void record();
          }, 2000);
        },
        { threshold: 0.5 },
      );
      observer.observe(sentinel);
    }

    // ── Writer 2: they left by a link that means "done here" ────────────
    // The pager's Next, and the Practice card's drill links. Not every link in
    // that card: white-cross.mdx offers /print in `practice.links`, and
    // crediting a lesson because the reader went to fetch the card set would
    // hide it from Resume permanently. Lesson.astro tags the qualifying ones.
    const exits = document.querySelectorAll<HTMLAnchorElement>("a[data-lesson-advance]");

    for (const exit of exits) {
      exit.addEventListener("click", (e) => {
        // Leave modified clicks alone — cmd/ctrl-click opens a new tab, and
        // stealing that to run an async write would break it.
        if (e.defaultPrevented || e.button !== 0) return;
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        if (exit.target && exit.target !== "_self") return;
        // Already written by the observer: let the browser navigate normally,
        // which keeps its own loading feedback instead of a dead 30ms.
        if (recorded) return;

        const href = exit.href;
        e.preventDefault();
        // Navigate as soon as the write lands, or after 400ms regardless. An
        // IndexedDB that is blocked (another tab mid-upgrade, a private window
        // that denies storage) must never strand the reader on the page.
        let gone = false;
        const go = (): void => {
          if (gone) return;
          gone = true;
          window.location.assign(href);
        };
        window.setTimeout(go, 400);
        void record().then(go);
      });
    }
  }
</script>
