---
/**
 * Wraps cubing.js's <twisty-player> web component.
 * With `anchor="end"` (the default here) the player starts at the case state
 * and plays the algorithm forward to solved — the core Cubepath pattern.
 */
interface Props {
  alg: string;
  puzzle?: "3x3x3" | "4x4x4" | "5x5x5";
  stickering?: string;
  /** "end" = show the case, play to solved; "start" = play from solved. */
  anchor?: "start" | "end";
  class?: string;
}

const {
  alg,
  puzzle = "3x3x3",
  stickering = "full",
  anchor = "end",
  class: className,
} = Astro.props;
---

<twisty-player
  class={className}
  puzzle={puzzle}
  alg={alg}
  experimental-setup-anchor={anchor}
  experimental-stickering={stickering === "full" ? undefined : stickering}
  hint-facelets="none"
  background="none"
  control-panel="bottom-row"
  tempo-scale="2"></twisty-player>

<script>
  // Register <twisty-player> lazily: immediately when a player is visible on
  // load (open <details> or not inside one); otherwise on the first toggle of
  // a <details> containing a player, or when the browser goes idle —
  // whichever comes first.
  let registered = false;
  function register() {
    if (registered) return;
    registered = true;
    void import("cubing/twisty");
  }
  if (
    document.querySelector("details[open] twisty-player") ||
    document.querySelector("twisty-player:not(details twisty-player)")
  ) {
    register();
  } else {
    // toggle does not bubble — listen in the capture phase.
    document.addEventListener(
      "toggle",
      (e) => {
        const el = e.target;
        if (el instanceof HTMLDetailsElement && el.open && el.querySelector("twisty-player")) {
          register();
        }
      },
      true,
    );
    if ("requestIdleCallback" in window) {
      requestIdleCallback(() => register());
    } else {
      setTimeout(register, 2000);
    }
  }
</script>

<style>
  twisty-player {
    width: 100%;
    max-width: 320px;
    height: 280px;
    contain: layout size;
  }
</style>
