---
/**
 * A case row: diagram icon, name + recognition, colored algorithm, and an
 * inline 3D player that shows the case and plays it to solved.
 *
 * The row carries its own `data-case` and `data-search` hooks so a page that
 * lists many of them — /reference/ — can filter and annotate rows without
 * being handed a parallel copy of the dataset it already rendered.
 */
import AlgText from "./AlgText.astro";
import TwistyPlayer from "./TwistyPlayer.astro";
import { caseById, primaryAlg } from "../data/algs";
import { caseIcon } from "../data/icons";
import { contextForCase } from "../lib/ladders";
import { caseHaystack, recognitionOf } from "../lib/casesearch";

interface Props {
  id: string;
  /** Show the 3D player expanded instead of behind a toggle. */
  open?: boolean;
  /**
   * DOM id, making the row a link target. Opt-in: the same case may be listed
   * twice on one page, and two rows sharing an id is an accessibility fault.
   */
  anchor?: string;
  /**
   * Extra words the listing page knows and the case does not — /reference
   * passes the section's own jump label, so a reader who types a heading they
   * can see ("4×4 parity") finds the rows under it.
   */
  searchExtra?: string;
}
const { id, open = false, anchor, searchExtra } = Astro.props;
const def = caseById.get(id);
if (!def) throw new Error(`CaseRow: unknown case id ${id}`);
const icon = caseIcon(id);
const alg = primaryAlg(def);
// Lean generated entries omit recognition; RICH carries it at build time.
const recognition = recognitionOf(def) ?? "";
// The row knows exactly which case it is showing, so it names the step rather
// than leaving the player to infer one: `group` gives the stage, `phase` the
// ladder. This is the three-tier ladder's only always-correct entry point.
const context = contextForCase(def);
---

<details
  class="case-row"
  open={open}
  id={anchor}
  data-case={id}
  data-search={caseHaystack(def, searchExtra)}
>
  <summary>
    {
      /* alt="": the name is the very next thing in the summary, so a described
         icon makes every row announce "Line, case diagram, Line, …" before the
         recognition cue that actually tells the rows apart. The informative
         description is not lost — the same image is the player's poster below,
         where posterAlt is its only label. */
      icon && <img src={icon} alt="" width="62" height="62" loading="lazy" />
    }
    <span class="meta">
      <span class="name">{def.name}</span>
      <span class="recognition">{recognition}</span>
    </span>
    <AlgText moves={alg} class="row-alg" />
    <span class="chip status" data-case-status hidden></span>
    <span class="play" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"
        ><path d="M7 5l10 7-10 7z"></path></svg
      >
    </span>
  </summary>
  <div class="player-slot">
    <div class="demo">
      <p class="demo-head">
        <span class="label">Solving</span>
        <span class="demo-name">{def.name}</span>
      </p>
      <TwistyPlayer
        alg={alg}
        puzzle={def.puzzle}
        stickering={def.stickering}
        context={context}
        {...icon ? { poster: icon } : {}}
        posterAlt={`${def.name} case diagram`}
      />
      <p class="hint">
        Starts at the case. Full colour is what this step solves, dim is already solved and has to
        survive it, grey is further down the method.
      </p>
      {
        /*
        The row's way through to the case's own page.

        Every TILE on /reference links to /case/<id>/; a curated ROW did not, so
        /case/444.pll.pure-e — rendered only as a row, and matching no grid
        filter — was built, precached and sitemapped with no inbound link
        anywhere on the site.

        Inside the disclosure body, NOT in the <summary>. A link in a <summary>
        is a control inside a control: axe flags it `nested-interactive`
        (serious) and e2e/a11y.spec.ts fails the build, which is exactly what
        the first attempt at this did.
      */
      }
      <a class="case-link" href={`/case/${id}/`}>Open the full case page →</a>
    </div>
  </div>
</details>

<style>
  /*
   * .chip, .label and .hint come from tokens.css — this component used to
   * restate .hint's three declarations under its own name. Only layout is set
   * on them here.
   */
  .case-row {
    border-block-start: 1px solid var(--line);
  }
  .case-row:first-of-type {
    border-block-start: 0;
  }
  summary {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  img {
    flex-shrink: 0;
  }
  .meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    width: 230px;
    flex-shrink: 0;
  }
  .name {
    font-weight: 600;
    font-size: var(--text-md);
  }
  .recognition {
    color: var(--soft);
    font-size: var(--text-sm);
  }
  :global(.row-alg) {
    flex-grow: 1;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  /* Written by /reference/'s progress script; absent everywhere else. */
  .status {
    flex-shrink: 0;
    white-space: nowrap;
  }
  .play {
    display: inline-flex;
    width: 36px;
    height: 36px;
    border-radius: var(--r-sm);
    background: var(--accent-soft);
    color: var(--accent);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .case-row[open] .play {
    background: var(--accent);
    color: var(--on-accent);
  }
  /* Tint the open row and hang the demo off it, so the player reads as part of
     the case rather than a loose box at the bottom of the list. */
  .case-row[open] > summary {
    background: var(--accent-soft);
  }
  .player-slot {
    padding: 0 var(--space-4) var(--space-5);
    background: var(--accent-soft);
  }
  .demo {
    width: min(100%, 380px);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4) var(--space-4);
    background: var(--card);
    border: 1px solid var(--line);
    border-inline-start: 3px solid var(--accent);
    border-radius: var(--r-md);
  }
  .demo-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    align-self: stretch;
    margin: 0;
  }
  .demo-name {
    font-weight: 600;
    font-size: var(--text-sm);
  }
  .demo .hint {
    text-align: center;
  }
  .case-link {
    font-size: var(--text-sm);
    font-weight: 600;
  }
  @media (max-width: 640px) {
    summary {
      flex-wrap: wrap;
      gap: var(--space-3);
    }
    .meta {
      width: calc(100% - 130px);
    }
    :global(.row-alg) {
      width: 100%;
      order: 3;
    }
    .status {
      order: 4;
    }
  }
</style>
