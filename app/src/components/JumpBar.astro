---
/**
 * An in-page jump bar: one chip per landmark on the page you are already on.
 *
 * WHY THIS EXISTS. Every long surface on this site had the same defect and
 * solved it a different number of times. The course index got a phase jump bar
 * and /reference got a section one; a LESSON got nothing, and a lesson is
 * 9,743px — 11.5 phone screens — at its longest. Measured on the built site: at
 * y=4,800 in that lesson the only links on screen were the five header
 * destinations. The breadcrumb sits at y=73 and the next navigation of any kind
 * is the phase-sibling list at y=9,173, so the middle ~70% of a long lesson was
 * a navigational dead zone.
 *
 * The addresses already existed. All 25 lessons carry >= 4 headings, 180
 * headings in all, and EVERY ONE of them already has an `id` — Astro's
 * rehype-heading-ids pass emits them and nothing pointed at any of them. That
 * is the same defect the course index had one level up (it shipped nine ids and
 * not one was a phase), and this is the same fix applied one level down.
 *
 * WHY A CHIP STRIP AND NOT A DRAWER. Published guidance is against hiding
 * navigation behind a disclosure when it can be visible, and against
 * side-scrolling strips for HETEROGENEOUS destinations — but explicitly allows
 * one for a homogeneous, predictably-ordered set that shows a visible cutoff
 * cue. A document-ordered list of one page's own headings behind the 16px mask
 * below is exactly that case.
 *
 * THE SPY IS SHARED, NOT RE-DERIVED. This shipped as plain anchors first, on
 * purpose: /reference's scroll-spy is gated against a real regression
 * (`scrollIntoView` walks EVERY ancestor scrolling box including the document,
 * which dragged the page backwards 52px at every section boundary), and a
 * second hand-written copy of that logic would have been the third place on
 * this site to get it wrong. `lib/jumpbar.ts` is that code MOVED; both bars
 * call it, so both get the traps right by construction.
 */
interface Item {
  /** The `id` of the element this chip lands on. Must exist on the page. */
  id: string;
  label: string;
}
interface Props {
  items: Item[];
  /** Names the nav for a screen reader — "On this page", "Course phases". */
  label: string;
}
const { items, label } = Astro.props;
---

{
  items.length > 0 && (
    <nav class="pagenav no-scrollbar" aria-label={label}>
      {items.map((it) => (
        <a class="chip" href={`#${it.id}`}>
          {it.label}
        </a>
      ))}
    </nav>
  )
}

<script>
  import { wirePageNav } from "../lib/jumpbar";
  wirePageNav();
</script>

<style>
  /*
   * Wraps at >=561px, scrolls at phone widths — the same idiom /reference's
   * jump bar uses, so the two bars behave identically rather than being two
   * inventions the reader has to learn separately.
   */
  .pagenav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    max-width: var(--shell-max);
    margin: 0 auto;
    padding: 0 var(--shell-x) var(--space-2);
  }
  /*
   * Layout only. `.chip`'s type, colour, padding and radius come from
   * tokens.css — which is the rule that file states for every shared component
   * class — and so do its `:hover` and `.here` states, so this bar and
   * /reference's are the same object rather than two that merely resemble each
   * other. Restating them here is how this bar came to ask for a `--ink-soft`
   * that does not exist, and to claim a font-weight change for `.here` that the
   * base chip's own 600 had already made invisible.
   */
  .chip {
    display: inline-block;
    white-space: nowrap;
  }
  /*
   * A different question, so a different mark. On the course index `.here` is
   * the phase you have scrolled to; `.resume` is the phase your PROGRESS is in,
   * which is where the hero button would take you. They are usually different
   * chips, and a reader wants both — "where I am looking" and "where I left
   * off". The dot is not colour alone.
   */
  .chip.resume::before {
    content: "•";
    margin-inline-end: 4px;
    color: var(--accent);
  }
  .chip.resume {
    border-color: var(--accent);
  }
  @media (max-width: 560px) {
    .pagenav {
      flex-wrap: nowrap;
      overflow-x: auto;
      /* The cutoff cue: the strip visibly fades where it continues, so the
         chips off-screen read as off-screen rather than as absent. */
      mask-image: linear-gradient(to right, #000 calc(100% - 16px), transparent);
    }
  }
  /*
   * WIDE SCREENS: the strip becomes a sidebar in the margin nobody was using.
   *
   * Prose is capped at --measure-prose (68ch, ~72 characters) because that is
   * the readable measure — at 1440px a lesson's text line is 612px and the
   * page leaves 390px empty on EACH side, and at 1920px it is 630px. The
   * answer to that waste is not longer lines, which would read worse; it is to
   * put something in the margin. This outline is the obvious tenant: as a
   * column it shows all 16 of a long lesson's sections at once, where the
   * strip could only show three or four and had to be scrolled.
   *
   * `position: fixed` takes it OUT of the header's flow, so the observer that
   * publishes --hdr-h stops counting it and the header goes back to being one
   * thin bar on wide screens — the sidebar costs no vertical chrome at all.
   * That also means `top` can be expressed against --hdr-h without a circular
   * dependency, because by then --hdr-h no longer contains this element.
   *
   * Anchored to the centre line rather than to the viewport edge, so it tracks
   * the prose column at every width instead of drifting away from it. The
   * width formula is what stops it colliding with the text at exactly 1100px,
   * where the margin is only 220px.
   *
   * Only `.pagenav` gets this. /reference's bar is `.toolbar`, a filter plus
   * ten chips on a 1200px `--measure-app` page whose margin is 120px — there
   * is no room for a sidebar there and no reason to want one.
   */
  @media (min-width: 1100px) {
    .pagenav {
      position: fixed;
      inset-block-start: calc(var(--hdr-h) + var(--space-5));
      inset-inline-end: calc(50% + var(--measure-prose) / 2 + var(--space-5));
      inline-size: min(13rem, calc(50vw - var(--measure-prose) / 2 - var(--space-6)));
      max-block-size: calc(100vh - var(--hdr-h) - var(--space-7));
      overflow-y: auto;
      flex-direction: column;
      align-items: stretch;
      flex-wrap: nowrap;
      gap: 2px;
      margin: 0;
      padding: 0;
      mask-image: none;
    }
    .chip {
      /* A list, not a row of pills: the border-per-chip reads as clutter in a
         column, and a left rule gives the current item somewhere to sit. */
      border: 0;
      border-inline-start: 2px solid var(--line);
      border-radius: 0;
      padding: 4px 10px;
      white-space: normal;
      text-align: start;
    }
    .chip:hover {
      border-inline-start-color: var(--accent);
      background: var(--accent-soft);
    }
    .chip.here {
      border-inline-start-color: var(--accent);
    }
  }

  /*
   * A landscape phone is 390px TALL. Two stacked sticky rows there is most of
   * the screen, so the whole header stops sticking rather than this row
   * silently costing a reader two thirds of their viewport.
   */
  @media (max-height: 500px) {
    .pagenav {
      display: none;
    }
  }
</style>
