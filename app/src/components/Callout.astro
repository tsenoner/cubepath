---
/**
 * The screen rendering of `palette.CALLOUTS`
 * (tools/cubepath/src/cubepath/palette.py), which the guide PDF renders in
 * guide/filters/callouts.lua. One definition, two renderings: the labels
 * below and the tint/ink token pair each type uses are asserted against that
 * module by tools/cubepath/tests/test_notation.py, so a callout can only be
 * restyled by moving the token both sides already share.
 *
 * One colour — the "ink" — draws the rule and the label. A rule in a second
 * hue is a second thing to keep true, and the Material 500s the guide used
 * for it measured 2.16-3.12:1 on white.
 */
interface Props {
  type?: "algorithm" | "tip" | "caution" | "info";
  title?: string;
}
const { type = "info", title } = Astro.props;
const LABELS = { algorithm: "Algorithm", tip: "Tip", caution: "Caution", info: "Info" };
const label = title ?? LABELS[type];
---

<aside class={`callout ${type}`}>
  <span class="label">{label}</span>
  <div class="body"><slot /></div>
</aside>

<style>
  .callout {
    padding: 12px 16px;
    border-radius: 6px;
    border-left: 4px solid;
    margin: 14px 0;
  }
  .label {
    display: block;
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 2px;
  }
  .body {
    font-size: 14px;
  }
  .body :global(p) {
    margin: 4px 0;
  }
  .algorithm {
    background: var(--accent-soft);
    border-color: var(--accent);
  }
  .algorithm .label {
    color: var(--accent);
  }
  .tip {
    background: var(--ok-soft);
    border-color: var(--ok);
  }
  .tip .label {
    color: var(--ok);
  }
  .caution {
    background: var(--warn-soft);
    border-color: var(--warn);
  }
  .caution .label {
    color: var(--warn);
  }
  .info {
    background: var(--card);
    border-color: var(--soft);
  }
  .info .label {
    color: var(--soft);
  }
</style>
