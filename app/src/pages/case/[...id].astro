---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import AlgText from "../../components/AlgText.astro";
import TwistyPlayer from "../../components/TwistyPlayer.astro";
import { ALL_CASES, CURATED_IDS, primaryAlg } from "../../data/algs";
import { CASE_SCRAMBLES } from "../../data/fullsets.gen";
import { RICH } from "../../data/fullsets.rich.gen";
import { caseIcon } from "../../data/icons";

export async function getStaticPaths() {
  return ALL_CASES.map((def) => ({ params: { id: def.id }, props: { def } }));
}

const { def } = Astro.props;
const icon = caseIcon(def.id);
// Lean generated entries carry only the primary alg; RICH holds the rest.
const recognition = def.recognition ?? RICH[def.id]?.recognition ?? "";
const alternates = CURATED_IDS.has(def.id)
  ? def.algs.filter((a) => !a.primary)
  : (RICH[def.id]?.alternates ?? []);
const scrambles = (CASE_SCRAMBLES[def.id] ?? []).slice(0, 4);
---

<Base title={`${def.name} — Cubepath`} description={recognition}>
  <Header active="reference" />
  <main>
    <nav class="crumbs"><a href="/reference/">Reference</a> <span>›</span> <span>{def.name}</span></nav>
    <div class="layout">
      <div class="left">
        <TwistyPlayer alg={primaryAlg(def)} puzzle={def.puzzle} stickering={def.stickering} />
        <p class="hint">The player starts at the case and solves it — drag to rotate.</p>
      </div>
      <div class="right">
        <div class="title-row">
          {icon && <img src={icon} alt={`${def.name} diagram`} width="84" height="84" />}
          <div>
            <h1>{def.name}</h1>
            <p class="recognition">{recognition}</p>
          </div>
        </div>
        <div class="chips">
          <span class="chip">{def.group}</span>
          {def.probability && <span class="chip">probability {def.probability}</span>}
        </div>
        <section class="card block">
          <span class="label">ALGORITHM</span>
          <p class="main-alg"><AlgText moves={primaryAlg(def)} /></p>
          {
            alternates.length > 0 && (
              <details>
                <summary>{alternates.length} alternate{alternates.length > 1 ? "s" : ""}</summary>
                <ul>
                  {alternates.map((a) => (
                    <li>
                      <AlgText moves={a.moves} />
                      {a.note && <span class="note"> — {a.note}</span>}
                    </li>
                  ))}
                </ul>
              </details>
            )
          }
        </section>
        {
          scrambles.length > 0 && (
            <section class="card block">
              <span class="label">SETUP SCRAMBLES</span>
              <ul class="scrambles">
                {scrambles.map((s) => (
                  <li class="alg">{s}</li>
                ))}
              </ul>
              <p class="hint">Each scramble produces this case from a solved cube (hold yellow up).</p>
            </section>
          )
        }
      </div>
    </div>
  </main>
</Base>

<style>
  main {
    max-width: 1000px;
    margin: 0 auto;
    padding: 26px 20px 60px;
  }
  .crumbs {
    margin-bottom: 16px;
  }
  .layout {
    display: grid;
    grid-template-columns: 340px minmax(0, 1fr);
    gap: 30px;
    align-items: start;
  }
  @media (max-width: 760px) {
    .layout {
      grid-template-columns: 1fr;
    }
  }
  .left {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }
  .title-row {
    display: flex;
    gap: 16px;
    align-items: center;
    margin-bottom: 10px;
  }
  h1 {
    font-size: 28px;
  }
  .recognition {
    color: var(--soft);
    margin: 4px 0 0;
  }
  .chips {
    display: flex;
    gap: 8px;
    margin-bottom: 14px;
  }
  .chip {
    padding: 3px 10px;
  }
  .block {
    padding: 14px 18px;
    margin-bottom: 12px;
  }
  .label {
    letter-spacing: 0.08em;
    color: var(--accent);
  }
  .main-alg {
    font-size: 16.5px;
    margin: 6px 0;
    overflow-wrap: anywhere;
  }
  details summary {
    cursor: pointer;
    font-size: 13px;
    color: var(--soft);
  }
  ul {
    margin: 8px 0 0;
    padding-left: 18px;
  }
  li {
    margin: 4px 0;
    overflow-wrap: anywhere;
  }
  .note {
    color: var(--faint);
    font-size: 12.5px;
  }
  .scrambles {
    list-style: none;
    padding: 0;
  }
  .scrambles li {
    font-size: 13px;
    padding: 4px 0;
    border-top: 1px solid var(--line);
  }
  .scrambles li:first-child {
    border-top: 0;
  }
</style>
