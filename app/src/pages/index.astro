---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";

const lessons = (await getCollection("lessons")).sort((a, b) => a.data.order - b.data.order);

const SECTIONS: { key: string; name: string; blurb: string }[] = [
  { key: "basics", name: "Basics", blurb: "Know the cube, read the moves." },
  { key: "phase-1", name: "Phase 1 — Beginner", blurb: "Solve the cube reliably with one trigger." },
  { key: "phase-1.5", name: "Phase 1.5 — Speed Tricks", blurb: "Same method, fewer moves." },
  { key: "phase-2", name: "Phase 2 — CFOP Switch", blurb: "The last-layer order that never changes again." },
  { key: "phase-3", name: "Phase 3 — Full 2-Look", blurb: "Every case, one look, one algorithm." },
];
---

<Base title="Cubepath — speedcubing from zero">
  <Header active="learn" />
  <main>
    <section class="hero">
      <h1>Speedcubing from zero.</h1>
      <p>
        One unbroken ladder from your first solve to full CFOP — every algorithm
        machine-verified, every case interactive in 3D. Free, offline, no account.
      </p>
      <div class="cta">
        <a class="btn primary" href={`/learn/${lessons[0]?.id}/`}>Start learning</a>
        <a class="btn" href="/reference/">All algorithms</a>
      </div>
    </section>

    <section class="ladder">
      {
        SECTIONS.map((s) => {
          const items = lessons.filter((l) => l.data.phase === s.key);
          if (items.length === 0) return null;
          return (
            <div class="section card">
              <div class="section-head">
                <h2>{s.name}</h2>
                <span class="blurb">{s.blurb}</span>
              </div>
              <ol>
                {items.map((l) => (
                  <li>
                    <a href={`/learn/${l.id}/`}>{l.data.title}</a>
                    <span class="desc">{l.data.description}</span>
                  </li>
                ))}
              </ol>
            </div>
          );
        })
      }
      <div class="section card coming">
        <div class="section-head">
          <h2>Full CFOP · 4×4 · 5×5</h2>
          <span class="blurb">Intuitive F2L, all 57 OLL + 21 PLL cases, and the big-cube courses — in progress.</span>
        </div>
      </div>
    </section>

    <footer>
      <span>Free forever · MIT + CC BY 4.0 · <a href="https://github.com/tsenoner/cubepath">Open source</a></span>
    </footer>
  </main>
</Base>

<style>
  main {
    max-width: 900px;
    margin: 0 auto;
    padding: 34px 20px 60px;
  }
  .hero {
    max-width: 640px;
    margin-bottom: 30px;
  }
  .hero h1 {
    margin-bottom: 8px;
  }
  .hero p {
    color: var(--soft);
    font-size: 16px;
    margin: 0 0 16px;
  }
  .cta {
    display: flex;
    gap: 12px;
  }
  .btn {
    font-weight: 600;
    font-size: 14px;
    padding: 10px 18px;
    border-radius: 8px;
    border: 1px solid var(--accent);
    color: var(--accent);
  }
  .btn:hover {
    text-decoration: none;
  }
  .btn.primary {
    background: var(--accent);
    color: #fff;
  }
  .ladder {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .section {
    padding: 18px 22px;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }
  .section h2 {
    font-size: 19px;
  }
  .blurb {
    color: var(--faint);
    font-size: 13px;
  }
  ol {
    margin: 0;
    padding-left: 22px;
  }
  li {
    margin: 6px 0;
  }
  li a {
    font-weight: 600;
  }
  .desc {
    color: var(--soft);
    font-size: 13px;
    margin-left: 8px;
  }
  .coming {
    opacity: 0.75;
  }
  footer {
    margin-top: 30px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    color: var(--faint);
    font-size: 12.5px;
  }
</style>
