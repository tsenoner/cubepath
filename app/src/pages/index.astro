---
import Base from "../layouts/Base.astro";
import TwistyPlayer from "../components/TwistyPlayer.astro";
import { caseById, primaryAlg } from "../data/algs";

const tperm = caseById.get("pll.t")!;
const ollParity = caseById.get("444.oll-parity")!;
---

<Base title="Cubepath — speedcubing from zero">
  <main>
    <header>
      <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
        {
          [0, 1, 2].flatMap((i) =>
            [0, 1, 2].map((j) => (
              <rect
                x={j * 7.33 + 0.8}
                y={i * 7.33 + 0.8}
                width="5.7"
                height="5.7"
                rx="1.5"
                fill="#FFD500"
                stroke="#333"
                stroke-width="0.9"
              />
            )),
          )
        }
      </svg>
      <span class="wordmark">cubepath</span>
      <span class="tag">speedcubing from zero — build preview (M0)</span>
    </header>

    <section class="proof">
      <div class="card demo">
        <h2>{tperm.name}</h2>
        <p class="recognition">{tperm.recognition}</p>
        <TwistyPlayer alg={primaryAlg(tperm)} stickering={tperm.stickering} />
        <p class="alg">{primaryAlg(tperm)}</p>
      </div>

      <div class="card demo">
        <h2>{ollParity.name}</h2>
        <p class="recognition">{ollParity.recognition}</p>
        <TwistyPlayer alg={primaryAlg(ollParity)} puzzle="4x4x4" />
        <p class="alg">{primaryAlg(ollParity)}</p>
      </div>

      <div class="card demo">
        <h2>Scramble (on-device)</h2>
        <p class="recognition">WCA random-state 3×3 scramble, generated in a worker — works offline.</p>
        <p class="alg" id="scramble-out" data-testid="scramble">…</p>
        <button id="scramble-btn" type="button">New scramble</button>
      </div>
    </section>
  </main>
</Base>

<script>
  import { randomScrambleForEvent } from "cubing/scramble";
  import { setSearchDebug } from "cubing/search";

  setSearchDebug({ showWorkerInstantiationWarnings: false });

  const out = document.getElementById("scramble-out")!;
  const btn = document.getElementById("scramble-btn")! as HTMLButtonElement;

  async function newScramble() {
    btn.disabled = true;
    out.textContent = "thinking…";
    try {
      const s = await randomScrambleForEvent("333");
      out.textContent = s.toString();
    } catch (e) {
      out.textContent = `scramble failed: ${e}`;
    } finally {
      btn.disabled = false;
    }
  }

  btn.addEventListener("click", newScramble);
  newScramble();
</script>

<style>
  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 24px 20px 60px;
  }
  header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 28px;
  }
  .wordmark {
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 700;
  }
  .tag {
    color: var(--faint);
    font-size: 13px;
  }
  .proof {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 16px;
  }
  .demo {
    padding: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
  }
  .recognition {
    color: var(--soft);
    font-size: 13px;
    margin: 0;
  }
  .alg {
    margin: 0;
    overflow-wrap: anywhere;
  }
  button {
    font: 600 14px var(--font-body);
    color: #fff;
    background: var(--accent);
    border: 0;
    border-radius: 8px;
    padding: 10px 18px;
    cursor: pointer;
  }
  button:disabled {
    opacity: 0.6;
  }
</style>
