---
/**
 * The course index.
 *
 * It used to be a hero plus 25 undifferentiated links in five bordered boxes:
 * nothing said which of them you had done, and the primary call to action
 * pointed at lesson one on your twentieth visit as surely as on your first.
 * It read as a table of contents because that is all it was.
 *
 * Four things change that, and all four are driven from the `lessons` store in
 * lib/db.ts, which LessonMeta.astro writes when a reader reaches the end of a
 * lesson or leaves it by a link that means "done here":
 *
 *   - a progress bar per phase, and one for the course,
 *   - a ✓ against every lesson you have finished,
 *   - a hero button that becomes "Resume lesson" the moment there is anything
 *     to resume, with the lesson's name on the reserved line beneath it,
 *   - a "Continue here" marker on the phase you are actually in, and on its
 *     jump chip — because the hero scrolls off the top of a 5,100px page and
 *     the ladder then answers "where am I" with nothing at all.
 *
 * All of it is applied client-side, after paint, from IndexedDB. The HTML
 * Astro emits is the honest zero-progress state, so the static build is
 * unaffected, the page is correct with JavaScript off, and there is nothing to
 * hydrate. Every box a client script writes into is reserved by the server, so
 * nothing on this page moves after paint.
 */
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import JumpBar from "../components/JumpBar.astro";
import Page from "../components/Page.astro";
import ProgressBar from "../components/ProgressBar.astro";
import { PHASES, phaseAnchor } from "../data/phases";

const lessons = (await getCollection("lessons")).sort((a, b) => a.data.order - b.data.order);

/**
 * A picture per phase, from the generated diagram set — the phase cards were
 * eight identical boxes of links, and a cube is what this course is about.
 *
 * Each one is the cube state the phase LEAVES YOU IN, drawn by the same
 * generator as the lesson diagrams, so nothing here is a stock illustration:
 * the beginner method ends solved, Phase 1.5 moves the first layer to the
 * bottom where it stays, Phase 3 finishes the top face, CFOP's headline is the
 * first two layers done as pairs.
 *
 * Three of these were wrong, in ways only visible at the size they render at:
 *
 *  - 4×4 and 5×5 pointed at NOTATION diagrams — a 3×3 with a large black
 *    "r (Rw)" or "M" printed across it. Wrong puzzle, a letter where a picture
 *    belongs, and 155px of art squeezed into the same 96px box as 92px art, so
 *    the cube inside came out visibly smaller than every other card's. They are
 *    real 4×4 and 5×5 cubes now, mid-reduction — centres built, edges not yet
 *    paired, which is what those phases actually teach.
 *  - Basics pointed at `step_flip`, drawn for the moment before the first layer
 *    exists, so three quarters of it is the not-reached grey. At 96px it read
 *    as an empty card.
 *  - Phase 3 pointed at the beginner ladder's step 6, which at this size is
 *    indistinguishable from step 5 on the card above it.
 *
 * Every entry renders into the same BOX (see `ART_W`/`ART_H`), which is what
 * stops a card from setting its own height — the bug this replaced was 155px
 * art in a 96px box.
 *
 * The box is not the same as the cube. `step_anatomy` carries an arrow, and
 * `render_step` pads an arrowed diagram by 6 rather than 4, so its viewBox is
 * 95.5x105.4 against the other seven's 91.5x101.4 — letterboxed into a shared
 * 92x101 it draws about 4% smaller. Left alone deliberately: the padding is
 * there so the rotation arrow is not clipped, and equalising it would mean
 * changing the pad for all 24 step diagrams, which the guide renders too.
 */
/**
 * One box for every phase cube, so the eight cards line up. Structural
 * rather than repeated per entry: the mismatch this replaced was 155px art
 * rendered into a 96px box.
 */
const ART_W = 92;
const ART_H = 101;

const PHASE_ART: Record<string, { src: string; alt: string }> = {
  basics: {
    src: "/diagrams/steps/step_anatomy.svg",
    alt: "A solved cube with an arrow showing the whole puzzle turning",
  },
  "phase-1": {
    src: "/diagrams/steps/step_7_solved.svg",
    alt: "A fully solved cube",
  },
  "phase-1.5": {
    src: "/diagrams/steps/step_2_corners.svg",
    alt: "A cube with its whole bottom layer solved",
  },
  "phase-2": {
    src: "/diagrams/steps/step_4_ycross.svg",
    alt: "A cube showing a yellow cross on the top face",
  },
  "phase-3": {
    src: "/diagrams/steps/step_oll_done.svg",
    alt: "A cube whose whole top face is yellow, its sides not yet matched",
  },
  "full-cfop": {
    src: "/diagrams/steps/step_3_edges.svg",
    alt: "A cube with its first two layers complete",
  },
  "444": {
    src: "/diagrams/steps/step_444_centres.svg",
    alt: "A 4×4 with its centres built and its edges not yet paired",
  },
  "555": {
    src: "/diagrams/steps/step_555_centres.svg",
    alt: "A 5×5 with its centres built and its edges not yet paired",
  },
};

const groups = PHASES.map((phase) => {
  const items = lessons.filter((l) => l.data.phase === phase.key);
  return {
    phase,
    art: PHASE_ART[phase.key],
    items,
    // Build-time arithmetic over a field the Zod schema guarantees is on every
    // lesson, so it cannot render blank.
    minutes: items.reduce((n, l) => n + l.data.minutes, 0),
  };
}).filter((g) => g.items.length > 0);

const firstHref = `/learn/${lessons[0]?.id}/`;
---

<Base title="Cubepath — speedcubing from zero">
  {
    /*
    The phase bar lives in the HEADER now, not in the page body.

    It was static — deliberately, on the reasoning that "a second sticky bar
    costs ~45px of an 844px phone viewport permanently". That premise is gone:
    the bar is a second ROW INSIDE `.site-header`, which the existing
    ResizeObserver already measures into --hdr-h, so there is no second sticky
    element and no second variable. What the old arrangement actually cost was
    reachability — measured at y=359 on a 5,248px page, so the only way to
    reach a phase was to already be in the first of 6.2 screens, which is the
    one screen where you can see the phases anyway.
  */
  }
  <Header active="learn">
    <JumpBar
      slot="pagenav"
      label="Course phases"
      items={groups.map(({ phase }) => ({ id: phaseAnchor(phase.key), label: phase.nav }))}
    />
  </Header>
  <Page>
    <section class="hero">
      <h1>Speedcubing from zero.</h1>
      <p class="lead">
        One unbroken ladder from your first solve to full CFOP — every algorithm machine-verified,
        every case interactive in 3D. Free, offline, no account.
      </p>
      {
        /*
        The button's label is SHORT and BOUNDED, and its destination is not.

        It used to be rewritten to `Resume: <lesson title>`, which grew it from
        129px to 358px, pushed "All algorithms" 72px down and moved the whole
        ladder 126px — CLS 0.106, past the Core Web Vitals threshold, on the
        site's front door, about 20ms after paint. On a phone the second button
        slid out from under a thumb that was already moving toward it. The
        variable-length part now goes on a line below, whose box the server
        reserves, so nothing above it can move. The one other label it can take
        — "Course complete — go practice" — is a fixed string that wraps to at
        most two lines, not a 40-character lesson title.
      */
      }
      <div class="cta">
        <a class="btn btn--primary" id="hero-cta" href={firstHref} data-hero-cta>Start learning</a>
        <a class="btn btn--accent" href="/reference/">All algorithms</a>
      </div>
      <p class="hint resume-title" data-resume-title></p>
      {
        /*
        `visibility`, not `hidden`: the box is reserved from first paint so
        revealing it moves nothing, while a first-time visitor still does not
        read "0 of 25", which is noise rather than information.
      */
      }
      <div class="course-bar" data-empty data-course-bar>
        <ProgressBar value={0} max={lessons.length} label="Course" />
      </div>
    </section>

    <ol class="ladder" role="list">
      {
        groups.map(({ phase, art, items, minutes }) => (
          <li class="phase card" id={phaseAnchor(phase.key)} data-phase={phase.key}>
            {art && (
              <img
                class="phase-art"
                src={art.src}
                alt={art.alt}
                width={ART_W}
                height={ART_H}
                loading="lazy"
                decoding="async"
              />
            )}
            <div class="phase-body">
              <h2>
                {phase.name}
                {/* Written after paint when this is the phase you are in. */}
                <span class="chip here-chip" hidden data-here>
                  Continue here
                </span>
              </h2>
              {/*
                What the phase COSTS. `minutes` is required on all 25 lessons
                and was rendered only inside a lesson — so the index, the one
                place a reader chooses a phase, threw it away. With twenty
                minutes free you could not tell that Phase 2 is one 14-minute
                lesson and Full CFOP is five totalling 74.
              */}
              <p class="hint blurb">
                {phase.blurb} · {items.length}
                {items.length === 1 ? " lesson" : " lessons"} · ≈{minutes} min
              </p>
              <div class="phase-bar">
                <ProgressBar value={0} max={items.length} label={`${phase.name} lessons`} />
              </div>
              <ol class="lessons" role="list">
                {items.map((l) => (
                  <li data-lesson-slug={l.id}>
                    <a href={`/learn/${l.id}/`}>{l.data.title}</a>
                    <span class="tick" hidden data-tick>
                      <span aria-hidden="true">✓</span>
                      <span class="sr-only">Completed</span>
                    </span>
                    <span class="desc">{l.data.description}</span>
                  </li>
                ))}
              </ol>
            </div>
          </li>
        ))
      }
    </ol>

    {
      /*
      Three of the project's four deliverables — the PDF guide, the printable
      card set, the installable app — were reachable from exactly one sentence
      buried in the reference page's lead paragraph. The cards are printed on
      physical card stock; nothing on the site pointed at them.
    */
    }
    <section class="offline card" aria-labelledby="offline-title">
      <h2 id="offline-title">Take it offline</h2>
      <p class="lead">
        Everything here works in airplane mode once the page has been visited. For paper, pocket and
        home screen:
      </p>
      {/* role="list": list-style:none strips "list, 3 items" in WebKit. */}
      <ul class="deliverables" role="list">
        <li>
          <a href="/cubepath.pdf">The PDF guide</a>
          <span class="desc">The whole method as one printable document, diagrams included.</span>
        </li>
        <li>
          <a href="/print/">The printable card set</a>
          <span class="desc">
            Three credit-card progression cards plus an annex — print, fold, carry.
          </span>
        </li>
        <li>
          <span class="install-line">
            <button class="btn install-btn" data-install-slot hidden type="button">
              Install Cubepath
            </button>
            <span class="no-install">Install as an app</span>
          </span>
          <span class="desc">
            On iPhone: <strong>Share</strong> → <strong>Add to Home Screen</strong>. Elsewhere your
            browser offers an install button in the address bar.
          </span>
        </li>
      </ul>
    </section>
  </Page>
</Base>

<style>
  .hero {
    margin-bottom: var(--space-6);
  }
  .hero h1 {
    margin-bottom: var(--space-2);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
  .resume-title {
    /* Reserved from first paint, so writing into it moves nothing below. */
    /* One line of --text-sm at the body's 1.55 line-height. Built from tokens
       rather than `1lh`: the unit is recent enough that an older browser would
       drop the declaration silently, and a silently-dropped reservation brings
       the layout shift straight back. */
    min-block-size: calc(var(--text-sm) * 1.55);
    margin-block-start: var(--space-2);
  }
  .course-bar {
    max-width: 22rem;
    margin-top: var(--space-5);
  }
  /* Not [hidden]: the box has to keep its space. visibility also keeps it out
     of the accessibility tree, so a first visit still does not read "0 of 25". */
  .course-bar[data-empty] {
    visibility: hidden;
  }

  .ladder {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /*
   * Picture first, then the phase. The art is a plain <img>, not a <Figure>:
   * Figure paints its own --card frame, and a framed figure inside a card is
   * the card-in-a-card the audit called out. Here the card *is* the frame.
   */
  .phase {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: var(--space-5);
    padding: var(--space-5);
  }
  .phase-art {
    inline-size: 96px;
    block-size: auto;
    object-fit: contain;
  }
  /*
   * You are here. The script already knew which phase this was — it computes
   * the first unfinished row to retarget the hero button — and spent that
   * knowledge only on the button, which scrolls off the top of a 5,100px page.
   * A rule plus a word, never colour alone.
   */
  .phase[data-state="current"] {
    box-shadow: inset 3px 0 0 var(--accent);
  }
  .here-chip {
    margin-inline-start: var(--space-3);
    vertical-align: middle;
    font-family: var(--font-body);
    white-space: nowrap;
  }
  .phase-body {
    display: grid;
    gap: var(--space-2);
  }
  .blurb {
    margin: 0;
  }
  .phase-bar {
    max-width: 18rem;
    margin: var(--space-1) 0 var(--space-2);
  }

  .lessons {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .lessons > li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: baseline;
    gap: 0 var(--space-2);
    padding-inline-start: var(--space-5);
    /* The row's own bullet: a hollow ring that the ✓ replaces once done. */
    position: relative;
  }
  .lessons > li::before {
    content: "";
    position: absolute;
    inset-inline-start: var(--space-1);
    inset-block-start: 0.45em;
    inline-size: 8px;
    block-size: 8px;
    border: 1.5px solid var(--line);
    border-radius: var(--r-pill);
  }
  .lessons > li[data-complete]::before {
    background: var(--ok);
    border-color: var(--ok);
  }
  .lessons a {
    font-weight: 600;
    grid-column: 1;
  }
  /*
   * The whole row is the tap target, not the 23px line of the title. Measured
   * at 390px: 63.5px rows whose link box was 23.3px, so two thirds of every row
   * on the site's primary navigation was a dead tap. The <li> is already
   * position: relative, so a transparent overlay is the whole fix — the
   * accessible name stays the title, and the description stays outside the
   * link's text. It does cost selection and long-press on the description.
   */
  .lessons a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .tick {
    grid-column: 2;
    font-weight: 600;
    color: var(--ok);
  }
  .desc {
    grid-column: 1 / -1;
    color: var(--soft);
    font-size: var(--text-sm);
  }
  /* A finished lesson steps back: the ladder should read as "what is left". */
  .lessons > li[data-complete] a {
    color: var(--soft);
  }

  .offline {
    margin-top: var(--space-6);
    padding: var(--space-5);
  }
  .deliverables {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }
  .deliverables > li {
    display: grid;
    gap: var(--space-1);
  }
  .deliverables a {
    font-weight: 600;
    justify-self: start;
  }
  .install-line {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .install-btn {
    font-size: var(--text-sm);
    padding: var(--space-1) var(--space-3);
  }
  .no-install {
    font-weight: 600;
  }
  /* When the browser offers a real install prompt, the button says it all. */
  .install-line:has(.install-btn:not([hidden])) .no-install {
    display: none;
  }

  /* .sr-only now lives in tokens.css — /reference needs the same utility. */

  @media (max-width: 560px) {
    .phase {
      grid-template-columns: 1fr;
      gap: var(--space-3);
      padding: var(--space-4);
    }
    .phase-art {
      inline-size: 72px;
    }
  }
</style>

<script>
  import { completedLessons } from "../lib/db";

  /**
   * Everything below reads the DOM the page already rendered — the lesson rows
   * are in course order, each carrying its slug — so there is no second copy of
   * the ladder to keep in step with the markup.
   */
  const rows = Array.from(document.querySelectorAll<HTMLElement>("[data-lesson-slug]"));
  const cta = document.querySelector<HTMLAnchorElement>("[data-hero-cta]");
  const courseBar = document.querySelector<HTMLElement>("[data-course-bar]");
  const resumeTitle = document.querySelector<HTMLElement>("[data-resume-title]");

  function paint(el: HTMLElement, done: number, total: number): void {
    el.style.setProperty("--pct", `${total === 0 ? 0 : (done / total) * 100}%`);
    const count = el.querySelector("[data-progress-count]");
    if (count) count.textContent = `${done}/${total}`;
    el.querySelector('[role="progressbar"]')?.setAttribute("aria-valuenow", String(done));
  }

  async function render(): Promise<void> {
    const done = await completedLessons();
    if (done.size === 0) return;

    for (const row of rows) {
      const slug = row.dataset.lessonSlug;
      if (!slug || !done.has(slug)) continue;
      row.dataset.complete = "1";
      const tick = row.querySelector<HTMLElement>("[data-tick]");
      if (tick) tick.hidden = false;
    }

    // Resume points at the first unfinished lesson in ladder order — not the
    // last one visited, which on a re-read would send you backwards. Worked out
    // before the phase pass because the phase pass marks the card holding it.
    const next = rows.find((r) => !r.dataset.complete);
    // The phase holding the row you would resume. Marked on the card and on its
    // jump chip, so the answer survives the hero scrolling off the screen.
    const currentPhase = next?.closest<HTMLElement>("[data-phase]");

    for (const phase of document.querySelectorAll<HTMLElement>("[data-phase]")) {
      const bar = phase.querySelector<HTMLElement>("[data-progress]");
      if (bar) {
        paint(
          bar,
          phase.querySelectorAll("[data-complete]").length,
          phase.querySelectorAll("[data-lesson-slug]").length,
        );
      }
      // "current" is the only value anything reads — the card's accent rule
      // below and the gate in e2e/nav.spec.ts. "done" and "ahead" were written
      // and asked for nowhere, and telling them apart cost a second pass over
      // every phase, re-counting rows this one has already counted.
      if (phase === currentPhase) phase.dataset.state = "current";
    }

    if (courseBar) {
      const bar = courseBar.querySelector<HTMLElement>("[data-progress]");
      // Ladder rows, not store rows. `done.size` counts what IndexedDB holds,
      // which after a lesson is renamed or retired includes slugs the ladder no
      // longer shows — and the bar would then read 26/25.
      if (bar) paint(bar, rows.filter((r) => r.dataset.complete).length, rows.length);
      courseBar.removeAttribute("data-empty");
    }

    const link = next?.querySelector("a");
    if (cta && link) {
      cta.href = link.getAttribute("href") ?? cta.href;
      // A fixed label, because the button is a tap target: the title goes on
      // the reserved line below so a 40-character lesson name cannot grow the
      // button and shove "All algorithms" out from under a moving thumb.
      cta.textContent = "Resume lesson";
      if (resumeTitle) resumeTitle.textContent = link.textContent?.trim() ?? "";
    } else if (cta) {
      cta.href = "/practice/";
      cta.textContent = "Course complete — go practice";
    }

    // ── You are here ───────────────────────────────────────────────────
    if (currentPhase) {
      const chip = currentPhase.querySelector<HTMLElement>("[data-here]");
      if (chip) chip.hidden = false;
      // By href, which is the chip's whole contract with the page: the card's
      // own id IS the fragment the chip points at. The chip used to carry a
      // second copy of the phase key purely so this line could find it, and
      // that copy needed CSS.escape because `phase-1.5` is not a legal selector
      // — the id `phaseAnchor()` builds is, and that is the point of it.
      const jump = document.querySelector<HTMLElement>(`.pagenav a[href="#${currentPhase.id}"]`);
      // `resume`, not `here`. Two different questions get asked of this bar and
      // they have different answers: `here` is which phase you have SCROLLED to
      // and is owned by the shared scroll-spy in lib/jumpbar.ts, while this is
      // which phase your PROGRESS is in — the one the hero would resume into.
      // They are usually different chips. Marking both with one class meant the
      // spy cleared this on its first callback.
      jump?.classList.add("resume");
    }
  }

  void render().catch(() => undefined);
</script>
