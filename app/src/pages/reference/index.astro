---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import CaseRow from "../../components/CaseRow.astro";
import { ALL_CASES, CASES } from "../../data/algs";
import { caseIcon } from "../../data/icons";

const GROUPS: { key: string; name: string }[] = [
  { key: "cross-eo", name: "Yellow Cross" },
  { key: "2look-oll-corners", name: "Corner Orientation (2-Look OLL)" },
  { key: "2look-pll-corners", name: "Corner Permutation (2-Look PLL)" },
  { key: "2look-pll-edges", name: "Edge Permutation (2-Look PLL)" },
  { key: "444-parity", name: "4×4 Parity" },
];

// Full sets, grouped by shape/type, linking to per-case pages.
function fullSet(prefix: string) {
  const items = ALL_CASES.filter((k) => k.id.startsWith(prefix) && k.phase.startsWith("full"));
  const groups = new Map<string, typeof items>();
  for (const k of items) {
    if (!groups.has(k.group)) groups.set(k.group, []);
    groups.get(k.group)!.push(k);
  }
  return [...groups.entries()];
}
const fullOLL = fullSet("oll.");
const fullPLL = fullSet("pll.");
const groupTitle = (g: string) =>
  g.replace(/^(oll|pll)-/, "").replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
---

<Base title="Algorithm Reference — Cubepath" description="Every Cubepath algorithm — machine-verified, tap to play in 3D.">
  <Header active="reference" />
  <main>
    <h1>Algorithm Reference</h1>
    <p class="lead">
      Every algorithm on this site is machine-verified against a cube simulator
      before it ships. Tap a case to play it in 3D. Prefer paper?
      <a href="/cubepath.pdf">Download the PDF guide</a>.
    </p>
    {
      GROUPS.map((g) => {
        const items = CASES.filter((k) => k.group === g.key);
        if (items.length === 0) return null;
        return (
          <section>
            <h2>{g.name}</h2>
            <div class="case-list card">
              {items.map((k) => (
                <CaseRow id={k.id} />
              ))}
            </div>
          </section>
        );
      })
    }

    <section>
      <h2>Full OLL — all 57 cases by shape</h2>
      <p class="lead">The complete orientation set, grouped the way you recognize them.</p>
      {
        fullOLL.map(([group, items]) => (
          <div class="full-group">
            <h3>{groupTitle(group)}</h3>
            <div class="icon-grid">
              {items.map((k) => (
                <a href={`/case/${k.id}/`} class="icon-cell" title={k.name}>
                  <img src={caseIcon(k.id)} alt={k.name} width="72" height="72" loading="lazy" />
                  <span>{k.name.replace("OLL ", "")}</span>
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </section>

    <section>
      <h2>Full PLL — all 21 cases</h2>
      <p class="lead">Permutations with their piece-movement arrows.</p>
      {
        fullPLL.map(([group, items]) => (
          <div class="full-group">
            <h3>{groupTitle(group)}</h3>
            <div class="icon-grid">
              {items.map((k) => (
                <a href={`/case/${k.id}/`} class="icon-cell" title={k.name}>
                  <img src={caseIcon(k.id)} alt={k.name} width="72" height="72" loading="lazy" />
                  <span>{k.name.replace("-Perm", "")}</span>
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </section>
  </main>
</Base>

<style>
  main {
    max-width: 900px;
    margin: 0 auto;
    padding: 34px 20px 60px;
  }
  .lead {
    color: var(--soft);
    margin: 8px 0 10px;
  }
  section {
    margin-top: 26px;
  }
  h2 {
    font-size: 20px;
    margin-bottom: 10px;
  }
  .case-list {
    overflow: hidden;
  }
  .full-group {
    margin: 14px 0;
  }
  .full-group h3 {
    font-size: 15px;
    color: var(--soft);
    margin-bottom: 8px;
  }
  .icon-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .icon-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 8px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--card);
    color: var(--soft);
    font-size: 12px;
    font-weight: 600;
  }
  .icon-cell:hover {
    text-decoration: none;
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
