---
// FROZEN PUBLIC ROUTES. /c0 /c1 /c2 /c3 are printed on physical cards; a
// printed card cannot be redeployed, so these paths can never change or 404.
// A card's own page is the one place a learner can check what comes next
// without turning the card over.
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Page from "../components/Page.astro";
import manifest from "../data/cards.json";

export function getStaticPaths() {
  return manifest.cards.map((card) => ({ params: { card: `c${card.index}` }, props: { card } }));
}

const { card } = Astro.props;
const next = manifest.cards.find((c) => c.slug === card.next_slug) ?? null;
const ladder = manifest.cards.filter((c) => c.num !== null);
---

<Base
  title={`${card.title} — Cubepath card ${card.num ?? "A"}`}
  description={`Cubepath printable card ${card.num ? `${card.num} of ${card.of}` : "annex"}: ${card.title}. What it covers, what unlocks the next card, and where to reprint it.`}
>
  <Header active="print" />
  <Page>
    <p class="label">{card.num ? `Card ${card.num} of ${card.of}` : "Annex — not a tier"}</p>
    <h1>{card.title}</h1>

    {
      card.unlock && (
        <section>
          <h2>What unlocks the next card</h2>
          <p class="gate">{card.unlock}</p>
          {card.master && <p class="hint">{card.master}</p>}
        </section>
      )
    }

    {
      card.supersedes && (
        <p class="hint">
          This card retires part of the previous one. That is the only thing in the set that gets
          replaced — everything else keeps working.
        </p>
      )
    }

    <section>
      <h2>Drill it with a real cube</h2>
      <p>
        Paper is for looking things up. Recognition is drilled with randomised setups in the <a
          href="/practice">trainer</a
        >, which checks your solution on a real cube model rather than showing you an answer.
      </p>
    </section>

    <section>
      <h2>Reprint this card</h2>
      <ul class="files">
        <li>
          <a href={`/cards/${card.fold_pdf.a4}`}>A4 — four copies of this card</a>
          <span>Single-sided, fold, glue, cut. No duplex printer needed.</span>
        </li>
        <li>
          <a href={`/cards/${card.fold_pdf.letter}`}>US Letter — four copies</a>
          <span>Same, Letter paper.</span>
        </li>
        <li>
          <a href={`/cards/${card.card_pdf}`}>Bare card</a>
          <span>Two 85.6 × 53.98 mm pages, for a print shop.</span>
        </li>
      </ul>
      <p class="hint">
        Print at 100 % / Actual size — the <a href="/print">print guide</a> has the per-viewer settings
        and the calibration check.
      </p>
    </section>

    <section>
      <h2>The ladder</h2>
      <ol class="ladder">
        {
          ladder.map((c) => (
            <li class={c.index === card.index ? "here" : ""}>
              <a href={c.route}>
                {c.num}/{c.of} {c.title}
              </a>
            </li>
          ))
        }
      </ol>
      {
        next && (
          <p class="hint">
            Next: <a href={next.route}>{next.title}</a>.
          </p>
        )
      }
    </section>
  </Page>
</Base>

<style>
  /*
   * Layout only. Width, centring and gutter come from <Page>; .label and .hint
   * come from tokens.css — this page used to spell them "kicker" and "note".
   */
  h1 {
    margin: var(--space-1) 0 0;
  }
  section {
    margin-top: var(--space-5);
  }
  h2 {
    margin-bottom: var(--space-3);
  }
  /* Same paragraph rhythm as /print, its sibling page. `p.hint` is spelled out
     because .hint is `margin: 0` — a caption default that would otherwise win
     over the element rule and jam the aside against the block above it. */
  p,
  p.hint {
    margin: var(--space-2) 0;
  }
  .gate {
    font-weight: 600;
  }
  .ladder {
    padding-left: var(--space-4);
  }
  .files {
    list-style: none;
    padding: 0;
  }
  .files li {
    margin: var(--space-2) 0;
  }
  .files span {
    display: block;
    color: var(--soft);
    font-size: var(--text-sm);
  }
  .ladder .here {
    font-weight: 700;
  }
</style>
