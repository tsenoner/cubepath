---
// FROZEN PUBLIC ROUTES. /c0 /c1 /c2 /c3 are printed on physical cards; a
// printed card cannot be redeployed, so these paths can never change or 404.
// A card's own page is the one place a learner can check what comes next
// without turning the card over.
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import manifest from "../data/cards.json";

export function getStaticPaths() {
  return manifest.cards.map((card) => ({ params: { card: `c${card.index}` }, props: { card } }));
}

const { card } = Astro.props;
const next = manifest.cards.find((c) => c.slug === card.next_slug) ?? null;
const ladder = manifest.cards.filter((c) => c.num !== null);
---

<Base
  title={`${card.title} — Cubepath card ${card.num ?? "A"}`}
  description={`Cubepath printable card ${card.num ? `${card.num} of ${card.of}` : "annex"}: ${card.title}. What it covers, what unlocks the next card, and where to reprint it.`}
>
  <Header />
  <main>
    <p class="kicker">{card.num ? `Card ${card.num} of ${card.of}` : "Annex — not a tier"}</p>
    <h1>{card.title}</h1>

    {
      card.unlock && (
        <section>
          <h2>What unlocks the next card</h2>
          <p class="gate">{card.unlock}</p>
          {card.master && <p class="note">{card.master}</p>}
        </section>
      )
    }

    {
      card.supersedes && (
        <p class="note">
          This card retires part of the previous one. That is the only thing in the set
          that gets replaced — everything else keeps working.
        </p>
      )
    }

    <section>
      <h2>Drill it with a real cube</h2>
      <p>
        Paper is for looking things up. Recognition is drilled with randomised setups in
        the <a href="/practice">trainer</a>, which checks your solution on a real cube
        model rather than showing you an answer.
      </p>
    </section>

    <section>
      <h2>Reprint this card</h2>
      <ul class="files">
        <li>
          <a href={`/cards/${card.fold_pdf.a4}`}>A4 — four copies of this card</a>
          <span>Single-sided, fold, glue, cut. No duplex printer needed.</span>
        </li>
        <li>
          <a href={`/cards/${card.fold_pdf.letter}`}>US Letter — four copies</a>
          <span>Same, Letter paper.</span>
        </li>
        <li>
          <a href={`/cards/${card.card_pdf}`}>Bare card</a>
          <span>Two 85.6 × 53.98 mm pages, for a print shop.</span>
        </li>
      </ul>
      <p class="note">
        Print at 100 % / Actual size — the <a href="/print">print guide</a> has the
        per-viewer settings and the calibration check.
      </p>
    </section>

    <section>
      <h2>The ladder</h2>
      <ol class="ladder">
        {
          ladder.map((c) => (
            <li class={c.index === card.index ? "here" : ""}>
              <a href={c.route}>
                {c.num}/{c.of} {c.title}
              </a>
            </li>
          ))
        }
      </ol>
      {next && <p class="note">Next: <a href={next.route}>{next.title}</a>.</p>}
    </section>
  </main>
</Base>

<style>
  main {
    max-width: 720px;
    margin: 0 auto;
    padding: 34px 20px 60px;
  }
  .kicker {
    color: var(--soft);
    font-size: 14px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0;
  }
  h1 {
    margin: 4px 0 0;
  }
  section {
    margin-top: 26px;
  }
  h2 {
    font-size: 20px;
    margin-bottom: 10px;
  }
  .gate {
    font-weight: 600;
  }
  .note {
    color: var(--soft);
    font-size: 14px;
  }
  .files,
  .ladder {
    padding-left: 18px;
  }
  .files {
    list-style: none;
    padding: 0;
  }
  .files li {
    margin: 8px 0;
  }
  .files span {
    display: block;
    color: var(--soft);
    font-size: 14px;
  }
  .ladder .here {
    font-weight: 700;
  }
</style>
