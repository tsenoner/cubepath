---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
---

<Base title="Practice — Cubepath" description="On-device WCA scrambles — works fully offline.">
  <Header active="practice" />
  <main>
    <h1>Practice</h1>
    <p class="lead">
      Scrambles are computed on your device — airplane mode works. The full
      trainer (case drills, spaced-repetition reviews, timer) is on its way.
    </p>
    <div class="card scrambler">
      <span class="label">3×3 · WCA random-state scramble</span>
      <p class="alg" id="scramble-out" data-testid="scramble">…</p>
      <button id="scramble-btn" type="button">New scramble</button>
    </div>
  </main>
</Base>

<script>
  import { randomScrambleForEvent } from "cubing/scramble";
  import { setSearchDebug } from "cubing/search";

  setSearchDebug({ showWorkerInstantiationWarnings: false });

  const out = document.getElementById("scramble-out")!;
  const btn = document.getElementById("scramble-btn")! as HTMLButtonElement;

  async function newScramble() {
    btn.disabled = true;
    out.textContent = "thinking…";
    try {
      const s = await randomScrambleForEvent("333");
      out.textContent = s.toString();
    } catch (e) {
      out.textContent = `scramble failed: ${e}`;
    } finally {
      btn.disabled = false;
    }
  }

  btn.addEventListener("click", newScramble);
  newScramble();
</script>

<style>
  main {
    max-width: 720px;
    margin: 0 auto;
    padding: 34px 20px 60px;
  }
  .lead {
    color: var(--soft);
    margin: 8px 0 22px;
  }
  .scrambler {
    padding: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    text-align: center;
  }
  .label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .alg {
    font-size: 17px;
    margin: 0;
    overflow-wrap: anywhere;
  }
  button {
    font: 600 14px var(--font-body);
    color: #fff;
    background: var(--accent);
    border: 0;
    border-radius: 8px;
    padding: 10px 18px;
    cursor: pointer;
  }
  button:disabled {
    opacity: 0.6;
  }
</style>
