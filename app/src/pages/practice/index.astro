---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Page from "../../components/Page.astro";
import EmptyState from "../../components/EmptyState.astro";
import ProgressBar from "../../components/ProgressBar.astro";
import { caseIcon } from "../../data/icons";
import { referenceHref } from "../../data/refsections";
import { defaultSettings, poolFor, selectionLabel, trainerSets } from "../../lib/trainer";

// Every trainable set, resolved once and used twice: the picker on the left and
// the per-set status accordions on the right. Both rails therefore always agree
// about what a set contains — the tracker used to render a hand-filtered 16 of
// 181 cases, so drilling all 57 OLLs could never put one in the review queue.
const sets = trainerSets();

// First paint uses the defaults. The island re-renders from stored settings —
// or from a ?group= deep link — as soon as it boots, so this only has to be
// right for the no-JS and first-frame cases.
const boot = defaultSettings();
const bootPool = poolFor(boot.groups);
const bootSelected = (key: string) => boot.groups.includes(key);

// A set small enough to read at a glance arrives expanded; Full OLL's 57 rows
// do not.
const OPEN_AT_MOST = 12;
---

<Base
  title="Practice — Cubepath"
  description="Drill cases with real scrambles and spaced-repetition reviews — fully offline."
>
  <Header active="practice" />
  <Page measure="app">
    <h1>Practice</h1>
    <p class="lead">
      Drill a set against real scrambles; spaced repetition brings each case back just before you
      would forget it. Offline, on this device.
    </p>

    <div class="columns">
      <details class="card panel" id="sets-panel" data-collapse-to="1024" open>
        <summary class="panel-head">
          <span class="panel-head-text">
            <h2>Case sets</h2>
            <span class="hint" id="sets-summary" aria-live="polite"
              >{selectionLabel(boot.groups)}</span
            >
          </span>
        </summary>
        <div class="panel-body">
          <div id="group-list" role="group" aria-label="Case sets to drill">
            {
              sets.map((s) => (
                <label class="group-row" data-group={s.key}>
                  <input type="checkbox" data-group-box={s.key} checked={bootSelected(s.key)} />
                  <span class="group-name">{s.name}</span>
                  <span class="group-count hint">{s.cases.length} cases</span>
                </label>
              ))
            }
          </div>

          <h3 class="spaced">Frequencies</h3>
          <div class="chip-row" id="freq-row" role="group" aria-label="Case frequency">
            <button class="chip" data-freq="realistic" type="button" aria-pressed="true"
              >Realistic</button
            >
            <button class="chip" data-freq="balanced" type="button" aria-pressed="false"
              >Balanced</button
            >
          </div>
          <p class="hint">Realistic weights cases by how often they appear in real solves.</p>

          <h3 class="spaced">Your data</h3>
          <div class="chip-row">
            <button class="chip" id="export-btn" type="button">Export backup</button>
            <button class="chip" id="import-btn" type="button">Import</button>
          </div>
          <input type="file" id="import-file" accept="application/json" hidden />
          <p class="hint" id="persist-note">Progress lives on this device.</p>
        </div>
      </details>

      <section class="main-col" aria-label="Drill">
        <p class="deep-note" id="deep-note" hidden></p>

        <div class="chip-row center" id="mode-row" role="group" aria-label="Practice mode">
          <button class="chip" data-mode="drill" type="button" aria-pressed="true">Drill</button>
          <button class="chip" data-mode="solve" type="button" aria-pressed="false"
            >Full solve</button
          >
          <button class="chip" data-mode="review" type="button" aria-pressed="false">
            Review <span id="due-badge" class="badge" hidden></span>
          </button>
        </div>
        <div class="chip-row center" id="puzzle-row" role="group" aria-label="Puzzle size" hidden>
          <button class="chip" data-puzzle="333" type="button" aria-pressed="true">3×3</button>
          <button class="chip" data-puzzle="444" type="button" aria-pressed="false">4×4</button>
          <button class="chip" data-puzzle="555" type="button" aria-pressed="false">5×5</button>
        </div>

        <div class="card stage" id="drill-stage">
          <h2 class="label" id="drill-label">SCRAMBLE · HOLD YELLOW UP</h2>
          <div class="drill-live" id="drill-live">
            <p class="alg scramble" id="drill-scramble" data-testid="scramble">…</p>
            <p
              class="timer"
              id="timer"
              tabindex="0"
              role="button"
              aria-label="Start or stop the timer"
            >
              0.00
            </p>
            <div class="chip-row center" id="stats-row">
              <span class="chip chip--ghost" id="stat-ao5">ao5 · —</span>
              <span class="chip chip--ghost" id="stat-ao12">ao12 · —</span>
              <span class="chip chip--best" id="stat-best" hidden></span>
            </div>
            <div class="chip-row center">
              <button class="btn btn--primary" id="next-btn" type="button">Next scramble</button>
              <button class="btn" id="show-case-btn" type="button">Show case</button>
            </div>
            <div id="case-reveal" hidden>
              {
                /* Both stay hidden until setCaseImage picks one: a visible <img>
                  with no src paints the browser's broken-image glyph. */
              }
              <img id="case-img" alt="" width="84" height="84" hidden />
              <p class="no-diagram" id="case-no-diagram" hidden>
                <span class="nd-set"></span><span class="nd-note">no diagram yet</span>
              </p>
              <div>
                <p class="case-name" id="case-name"></p>
                <p id="case-alg"></p>
                {
                  /*
                  The way OUT. Every other surface points into the trainer — all
                  25 lessons and all 129 case pages link here — and until this
                  link the trainer pointed nowhere: `main` held zero <a>
                  elements, so a reader who drilled a case, failed it and wanted
                  to study it had no route except the browser's back button.
                  One hop is enough: the case page already carries the teaching
                  lesson, the reference row and the 3D player, so linking there
                  buys all three without shipping a case->lesson map to the
                  client (lib/teaches.ts is build-time only by rule).
                */
                }
                <p class="case-out"><a id="case-link" href="/">Open the full case page →</a></p>
              </div>
            </div>
            <p class="hint">Space starts and stops the timer · works in airplane mode</p>
          </div>
          <div id="drill-empty" hidden>
            <EmptyState glyph="◻" title="No case set selected">
              Tick a set under <b>Case sets</b> and a scramble for one of its cases appears here. Lesson
              links like <code>?group=full-pll</code> pick the set for you.
            </EmptyState>
          </div>
        </div>

        <div class="card stage" id="review-stage" hidden>
          <h2 class="label">REVIEW · RECALL THE ALGORITHM</h2>
          <div id="review-body" hidden>
            <img id="review-img" alt="" width="110" height="110" hidden />
            <p class="no-diagram" id="review-no-diagram" hidden>
              <span class="nd-set"></span><span class="nd-note">no diagram yet</span>
            </p>
            <p class="case-name" id="review-name"></p>
            <button class="btn btn--primary" id="reveal-btn" type="button">Reveal algorithm</button>
            <div id="review-answer" hidden>
              <p id="review-alg" class="review-alg"></p>
              {
                /* Same way out as the drill stage — a failed review is exactly
                  the moment a reader wants the case page. */
              }
              <p class="case-out"><a id="review-link" href="/">Open the full case page →</a></p>
              <div class="chip-row center" id="grade-row">
                <button class="btn grade grade--again" data-grade="1" type="button"
                  >Again <small></small></button
                >
                <button class="btn grade" data-grade="2" type="button">Hard <small></small></button>
                <button class="btn grade grade--good" data-grade="3" type="button"
                  >Good <small></small></button
                >
                <button class="btn grade" data-grade="4" type="button">Easy <small></small></button>
              </div>
            </div>
          </div>
          <div id="review-empty" hidden>
            <EmptyState glyph="✓" title="Nothing due">
              Cases arrive here once you mark them <b>learning</b> under <b>Your cases</b>. A few
              reviews a day is what stops an algorithm from fading.
            </EmptyState>
          </div>
        </div>
      </section>

      <details class="card panel" id="cases-panel" data-collapse-to="768" open>
        <summary class="panel-head">
          <span class="panel-head-text">
            <h2>Your cases</h2>
            <span class="hint" id="cases-summary" aria-live="polite"
              >{selectionLabel(boot.groups)}</span
            >
          </span>
        </summary>
        <div class="panel-body">
          <ProgressBar id="learned-bar" label="Learned" value={0} max={bootPool.length} />
          <p class="hint spaced-sm">
            Tap a case to cycle it unseen → learning → learned. Marking one <b>learning</b> schedules
            it for review.
          </p>
          <div id="case-status-list">
            {
              sets.map((s) => (
                <details
                  class="set"
                  data-set-section={s.key}
                  open={s.cases.length <= OPEN_AT_MOST}
                  hidden={!bootSelected(s.key)}
                >
                  <summary class="set-head">
                    <span class="set-name">{s.name}</span>
                    <span class="set-count hint">{s.cases.length}</span>
                  </summary>
                  {/*
                    A trainer group key IS a /reference section id — the same
                    strings — so this edge costs no new data. It sits OUTSIDE
                    the <summary>: a link inside a summary is a control inside a
                    control, which axe fails the build on, and this repo already
                    made that mistake once on /reference's rows.
                  */}
                  <p class="set-out">
                    <a href={referenceHref(s.key)}>See this set in the reference →</a>
                  </p>
                  {s.cases.map((c) =>
                    caseIcon(c.id) ? (
                      <button class="status-row" data-case={c.id} type="button">
                        <img src={caseIcon(c.id)} alt="" width="40" height="40" loading="lazy" />
                        <span class="status-name">{c.name}</span>
                        <span class="chip status-chip" data-status-chip={c.id}>
                          unseen
                        </span>
                      </button>
                    ) : (
                      <button class="status-row" data-case={c.id} type="button">
                        {/* Keeps the rows aligned where a case has no art yet —
                            a missing thumbnail otherwise reads as a broken img. */}
                        <span class="row-blank" aria-hidden="true" />
                        <span class="status-name">{c.name}</span>
                        <span class="chip status-chip" data-status-chip={c.id}>
                          unseen
                        </span>
                      </button>
                    ),
                  )}
                </details>
              ))
            }
          </div>
          <div id="cases-empty" hidden={bootPool.length > 0}>
            <EmptyState glyph="◇" title="No sets selected">
              Cases show up here for whichever sets are ticked under <b>Case sets</b>. Tap one to
              mark it <b>learning</b> and it joins the review queue.
            </EmptyState>
          </div>
          <p class="visually-hidden" role="status" id="status-announce"></p>
        </div>
      </details>
    </div>

    <script is:inline>
      // Runs during parse, before the first paint. The panels ship open, so a
      // no-JS visitor and a wide viewport both get the full rails; anything
      // narrower than a panel's own breakpoint collapses it here. That is what
      // keeps the timer at the top of a phone screen instead of 1.15 screens
      // down behind ten checkboxes and a settings panel.
      document.querySelectorAll("[data-collapse-to]").forEach(function (el) {
        if (window.innerWidth <= Number(el.getAttribute("data-collapse-to"))) {
          el.removeAttribute("open");
        }
      });
    </script>
  </Page>
</Base>

<script>
  import { caseById, primaryAlg, type CaseDef } from "../../data/algs";
  import { caseIcon } from "../../data/icons";
  import {
    averageOf,
    defaultSettings,
    formatTime,
    groupLabel,
    loadSettings,
    parseGroupParam,
    pickCase,
    poolFor,
    saveSettings,
    selectionLabel,
    setupScramble,
    type TrainerSettings,
  } from "../../lib/trainer";
  import { allProgress, ensurePersistence, setStatus, type CaseStatus } from "../../lib/db";
  import { dueQueue, ensureCard, previewIntervals, review } from "../../lib/srs";
  import type { Grade } from "ts-fsrs";

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  /**
   * Show a case diagram, or a labelled placeholder tile naming its set.
   *
   * Two hazards, both measured: a visible <img> with no src renders the
   * broken-image glyph plus its alt text, and merely hiding the img leaves the
   * PREVIOUS case's diagram on the element — so the src is cleared either way.
   * The placeholder is the common path today: 104 of 185 cases (all F2L, 4×4
   * and 5×5) have no diagram art yet, and a bare gap reads as a broken page.
   */
  function setCaseImage(img: HTMLImageElement, fallback: HTMLElement, def: CaseDef) {
    const src = caseIcon(def.id);
    img.hidden = !src;
    fallback.hidden = !!src;
    if (src) {
      img.src = src;
      img.alt = `${def.name} case diagram`;
      return;
    }
    img.removeAttribute("src");
    img.alt = "";
    fallback.querySelector(".nd-set")!.textContent = groupLabel(def);
  }

  /** Clear the case reveal entirely — no stale diagram, name or algorithm. */
  function clearCaseReveal() {
    $("case-reveal").hidden = true;
    $<HTMLImageElement>("case-img").removeAttribute("src");
    $<HTMLImageElement>("case-img").hidden = true;
    $("case-no-diagram").hidden = true;
    $("case-name").textContent = "";
    $("case-alg").innerHTML = "";
  }

  // An IndexedDB failure must not kill the island — fall back to defaults.
  let settings: TrainerSettings;
  try {
    settings = await loadSettings();
  } catch (err) {
    console.error("cubepath: failed to load trainer settings, using defaults", err);
    settings = defaultSettings();
  }
  /** Persisting is best-effort: private mode and a full quota both throw. */
  async function persist() {
    try {
      await saveSettings(settings);
    } catch (err) {
      console.error("cubepath: failed to save trainer settings", err);
    }
  }

  let mode: "drill" | "solve" | "review" = "drill";
  let solvePuzzle: "333" | "444" | "555" = "333";
  let lastCase: string | undefined;
  const times: number[] = [];
  let timerStart = 0;
  let timerTick: number | undefined;

  // ── Selection ───────────────────────────────────────────────────────
  /** Toggle one exclusive chip group, in both the class and the a11y tree. */
  function setPressed(selector: string, active: Element | null) {
    for (const chip of document.querySelectorAll<HTMLElement>(selector)) {
      const on = chip === active;
      chip.classList.toggle("chip--active", on);
      chip.setAttribute("aria-pressed", String(on));
    }
  }

  /**
   * Push `settings` into every part of the page that reflects it: the
   * checkboxes, both panel summaries, and which per-set accordions the tracker
   * shows. The tracker follows the selection rather than a fixed list, so a
   * case can be marked "learning" — and so enter the FSRS queue — for any of
   * the 181 cases, not just the 16 curated ones.
   */
  function applySelection() {
    for (const box of document.querySelectorAll<HTMLInputElement>("[data-group-box]")) {
      box.checked = settings.groups.includes(box.dataset.groupBox!);
    }
    setPressed("[data-freq]", document.querySelector(`[data-freq="${settings.frequencies}"]`));

    const label = selectionLabel(settings.groups);
    $("sets-summary").textContent = label;
    $("cases-summary").textContent = label;

    let shown = 0;
    for (const section of document.querySelectorAll<HTMLElement>("[data-set-section]")) {
      const on = settings.groups.includes(section.dataset.setSection!);
      section.hidden = !on;
      if (on) shown++;
    }
    $("cases-empty").hidden = shown > 0;
  }

  for (const box of document.querySelectorAll<HTMLInputElement>("[data-group-box]")) {
    box.addEventListener("change", async () => {
      const key = box.dataset.groupBox!;
      settings.groups = box.checked
        ? [...settings.groups, key]
        : settings.groups.filter((g) => g !== key);
      await persist();
      applySelection();
      await renderStatuses();
      await nextScramble();
    });
  }
  for (const chip of document.querySelectorAll<HTMLElement>("[data-freq]")) {
    chip.addEventListener("click", async () => {
      settings.frequencies = chip.dataset.freq as TrainerSettings["frequencies"];
      await persist();
      applySelection();
    });
  }

  // ── Drill ───────────────────────────────────────────────────────────
  // Generation counter: a slow async scramble must not clobber the DOM after
  // the user has already requested a newer one (or switched mode/puzzle).
  let scrambleGen = 0;
  async function nextScramble() {
    const gen = ++scrambleGen;
    if (mode === "solve") {
      $("drill-label").textContent = "SCRAMBLE · FULL SOLVE";
      $("drill-live").hidden = false;
      $("drill-empty").hidden = true;
      $("drill-scramble").textContent = "thinking…";
      $("show-case-btn").hidden = true;
      const { randomScrambleForEvent } = await import("cubing/scramble");
      if (gen !== scrambleGen) return;
      const s = await randomScrambleForEvent(solvePuzzle);
      if (gen !== scrambleGen) return;
      $("drill-scramble").textContent = s.toString();
      $("case-reveal").hidden = true;
      return;
    }
    $("show-case-btn").hidden = false;
    const pool = poolFor(settings.groups);
    if (pool.length === 0) {
      // Nothing to drill: swap the whole live stage for the empty state rather
      // than leaving a live timer and two buttons over a dead scramble.
      $("drill-label").textContent = "SCRAMBLE";
      $("drill-live").hidden = true;
      $("drill-empty").hidden = false;
      clearCaseReveal();
      return;
    }
    $("drill-live").hidden = false;
    $("drill-empty").hidden = true;
    const def = pickCase(pool, settings.frequencies, lastCase);
    lastCase = def.id;
    const cubeName = { "3x3x3": "3×3", "4x4x4": "4×4", "5x5x5": "5×5" }[def.puzzle];
    $("drill-label").textContent = `SCRAMBLE · ${cubeName} · HOLD YELLOW UP`;
    $("drill-scramble").textContent = setupScramble(def);
    $("case-reveal").hidden = true;
    setCaseImage($<HTMLImageElement>("case-img"), $("case-no-diagram"), def);
    $("case-name").textContent = def.name;
    $<HTMLAnchorElement>("case-link").href = `/case/${def.id}/`;
    $("case-alg").innerHTML = "";
    const algSpan = document.createElement("span");
    algSpan.className = "alg";
    algSpan.textContent = primaryAlg(def);
    $("case-alg").append(algSpan);
  }
  $("next-btn").addEventListener("click", nextScramble);
  $("show-case-btn").addEventListener("click", () => {
    $("case-reveal").hidden = !$("case-reveal").hidden;
  });

  function stopTimer() {
    if (timerTick === undefined) return;
    clearInterval(timerTick);
    timerTick = undefined;
    const elapsed = performance.now() - timerStart;
    times.push(elapsed);
    $("timer").textContent = formatTime(elapsed);
    const ao5 = averageOf(times, 5);
    const ao12 = averageOf(times, 12);
    $("stat-ao5").textContent = `ao5 · ${ao5 ? formatTime(ao5) : "—"}`;
    $("stat-ao12").textContent = `ao12 · ${ao12 ? formatTime(ao12) : "—"}`;
    const best = Math.min(...times);
    const bestEl = $("stat-best");
    bestEl.hidden = false;
    bestEl.textContent = `best · ${formatTime(best)}`;
    void ensurePersistence();
    void nextScramble();
  }
  function startTimer() {
    timerStart = performance.now();
    timerTick = window.setInterval(() => {
      $("timer").textContent = formatTime(performance.now() - timerStart);
    }, 47);
  }
  // Space belongs to whatever control has focus: it activates buttons, toggles
  // checkboxes and types a space. Claim it for the timer only when the page
  // background has focus, and never blur — stealing focus made every case-set
  // checkbox and every button on this page unusable from the keyboard.
  const KEEPS_SPACE = "button, input, select, textarea, summary, a[href], [contenteditable]";
  document.addEventListener("keydown", (e) => {
    if (e.code !== "Space" || e.repeat || mode === "review") return;
    if (e.target instanceof Element && e.target.closest(KEEPS_SPACE)) return;
    e.preventDefault();
    timerTick === undefined ? startTimer() : stopTimer();
  });
  $("timer").addEventListener("click", () => {
    timerTick === undefined ? startTimer() : stopTimer();
  });

  // ── Case status list ────────────────────────────────────────────────
  const STATUS_ORDER: CaseStatus[] = ["unseen", "learning", "learned"];

  /** Repaint every status pill, the row labels, and the learned bar. */
  async function renderStatuses() {
    const progress = new Map((await allProgress()).map((p) => [p.caseId, p.status]));
    // A case can appear in two sets at once (the 2-look sets overlap the full
    // ones by id), so every row carrying the id is updated, not just the first.
    for (const row of document.querySelectorAll<HTMLElement>("[data-case]")) {
      const status = progress.get(row.dataset.case!) ?? "unseen";
      const chip = row.querySelector<HTMLElement>("[data-status-chip]")!;
      chip.textContent = status;
      chip.dataset.value = status;
      const name = row.querySelector(".status-name")?.textContent ?? row.dataset.case!;
      row.setAttribute("aria-label", `${name} — ${status}. Activate to cycle status.`);
    }
    const pool = poolFor(settings.groups);
    const done = pool.filter((c) => progress.get(c.id) === "learned").length;
    const bar = $("learned-bar");
    bar.style.setProperty("--pct", pool.length === 0 ? "0%" : `${(done / pool.length) * 100}%`);
    bar.querySelector("[data-progress-count]")!.textContent = `${done}/${pool.length}`;
    const track = bar.querySelector('[role="progressbar"]')!;
    track.setAttribute("aria-valuenow", String(done));
    track.setAttribute("aria-valuemax", String(pool.length));
  }

  // One delegated listener: the tracker now renders every case in every set
  // (~200 rows), and 200 listeners is 200 closures for nothing.
  $("case-status-list").addEventListener("click", async (e) => {
    const row = (e.target as Element | null)?.closest<HTMLElement>("[data-case]");
    if (!row) return;
    const id = row.dataset.case!;
    const chip = row.querySelector<HTMLElement>("[data-status-chip]")!;
    const current = (chip.dataset.value ?? "unseen") as CaseStatus;
    const next = STATUS_ORDER[(STATUS_ORDER.indexOf(current) + 1) % 3]!;
    await setStatus(id, next);
    // Entering "learning" seeds the FSRS card so the case joins the review
    // queue; leaving keeps the card (its history must survive status cycles).
    if (next === "learning") await ensureCard(id, new Date());
    void ensurePersistence();
    // The pill is inside the button, so its change is not announced on its own.
    $("status-announce").textContent = `${row.querySelector(".status-name")?.textContent}: ${next}`;
    await renderStatuses();
    await refreshDueBadge();
  });

  // ── Review (FSRS) ───────────────────────────────────────────────────
  let reviewQueue: string[] = [];
  async function refreshDueBadge() {
    const due = await dueQueue(new Date());
    const badge = $("due-badge");
    badge.hidden = due.length === 0;
    badge.textContent = String(due.length);
    return due;
  }
  async function nextReview() {
    reviewQueue = await refreshDueBadge();
    // A card can outlive its case (renamed ids, a backup from an older build).
    // Skipping such a card dead-ends the queue — grading re-persists it, so it
    // returns forever — and leaves this stage half-built. Purge, then carry on.
    const unknown = reviewQueue.filter((id) => !caseById.has(id));
    if (unknown.length > 0) {
      const { forgetCards } = await import("../../lib/db");
      await forgetCards(unknown);
      console.warn("cubepath: dropped review cards for unknown cases", unknown);
      reviewQueue = await refreshDueBadge();
    }
    // Resolve the case *before* deciding what to show, so the stage is never
    // revealed in a state the rest of this function then fails to fill in.
    const def = reviewQueue.length > 0 ? caseById.get(reviewQueue[0]!) : undefined;
    $("review-body").hidden = !def;
    $("review-empty").hidden = !!def;
    if (!def) return;
    setCaseImage($<HTMLImageElement>("review-img"), $("review-no-diagram"), def);
    $("review-name").textContent = def.name;
    $<HTMLAnchorElement>("review-link").href = `/case/${def.id}/`;
    $("review-answer").hidden = true;
    $("reveal-btn").hidden = false;
    const labels = await previewIntervals(def.id, new Date());
    for (const btn of document.querySelectorAll<HTMLElement>("[data-grade]")) {
      const name = { 1: "Again", 2: "Hard", 3: "Good", 4: "Easy" }[Number(btn.dataset.grade)]!;
      btn.querySelector("small")!.textContent = labels[name] ?? "";
    }
    const algP = $("review-alg");
    algP.textContent = primaryAlg(def);
    algP.className = "alg review-alg";
  }
  $("reveal-btn").addEventListener("click", () => {
    $("review-answer").hidden = false;
    $("reveal-btn").hidden = true;
  });
  for (const btn of document.querySelectorAll<HTMLElement>("[data-grade]")) {
    btn.addEventListener("click", async () => {
      const id = reviewQueue[0];
      // Never write SRS history for a case this build does not have.
      if (!id || !caseById.has(id)) return;
      await review(id, Number(btn.dataset.grade) as Grade, new Date());
      void ensurePersistence();
      await nextReview();
    });
  }

  // Seed review cards when a case is drilled and revealed? Keep explicit:
  // drilling adds nothing; the "learning" status click and grading do.

  // ── Full-solve puzzle picker ────────────────────────────────────────
  for (const chip of document.querySelectorAll<HTMLElement>("[data-puzzle]")) {
    chip.addEventListener("click", async () => {
      solvePuzzle = chip.dataset.puzzle as typeof solvePuzzle;
      setPressed("[data-puzzle]", chip);
      if (mode === "solve") await nextScramble();
    });
  }

  // ── Mode switching ──────────────────────────────────────────────────
  for (const chip of document.querySelectorAll<HTMLElement>("[data-mode]")) {
    chip.addEventListener("click", async () => {
      mode = chip.dataset.mode as typeof mode;
      setPressed("[data-mode]", chip);
      $("drill-stage").hidden = mode === "review";
      $("review-stage").hidden = mode !== "review";
      $("puzzle-row").hidden = mode !== "solve";
      if (mode === "review") await nextReview();
      else await nextScramble();
    });
  }

  // ── Backup ──────────────────────────────────────────────────────────
  $("export-btn").addEventListener("click", async () => {
    const { exportBackup } = await import("../../lib/db");
    const data = await exportBackup();
    const blob = new Blob([JSON.stringify(data, null, 1)], { type: "application/json" });
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = `cubepath-backup-${new Date().toISOString().slice(0, 10)}.json`;
    a.click();
    URL.revokeObjectURL(a.href);
  });
  $("import-btn").addEventListener("click", () => $("import-file").click());
  $<HTMLInputElement>("import-file").addEventListener("change", async (e) => {
    const input = e.target as HTMLInputElement;
    const file = input.files?.[0];
    // Reset so re-importing the same file fires "change" again.
    input.value = "";
    if (!file) return;
    try {
      const { importBackup } = await import("../../lib/db");
      const { skipped } = await importBackup(JSON.parse(await file.text()), (id) =>
        caseById.has(id),
      );
      await renderStatuses();
      await refreshDueBadge();
      $("persist-note").textContent = skipped.length
        ? `Backup imported — ${skipped.length} card(s) for retired cases were dropped.`
        : "Backup imported.";
    } catch (err) {
      $("persist-note").textContent = `Import failed: ${err}`;
    }
  });
  void navigator.storage?.persisted?.().then((p) => {
    if (p) $("persist-note").textContent = "Progress protected on this device.";
  });

  // ── Boot ────────────────────────────────────────────────────────────
  // `?group=` is the handoff from a lesson: "Practice this set" links here with
  // the set it just taught. It wins over the stored selection (the reader asked
  // for it explicitly) and is then persisted, so a reload keeps it. Unknown
  // keys are dropped by parseGroupParam rather than emptying the pool.
  const requested = parseGroupParam(new URLSearchParams(location.search).get("group"));
  if (requested.length > 0) {
    settings.groups = requested;
    await persist();
    const note = $("deep-note");
    note.textContent = `From your link · ${selectionLabel(requested)}`;
    note.hidden = false;
  }

  applySelection();
  setPressed("[data-mode]", document.querySelector('[data-mode="drill"]'));
  setPressed("[data-puzzle]", document.querySelector('[data-puzzle="333"]'));
  try {
    await Promise.all([nextScramble(), renderStatuses(), refreshDueBadge()]);
  } catch (err) {
    // Storage failures must not take the drill stage down with them.
    console.error("cubepath: practice boot failed", err);
  }
</script>

