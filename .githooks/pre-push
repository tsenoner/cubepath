#!/usr/bin/env bash
# Local CI-equivalent gate: nothing that would fail CI may be pushed.
# Installed via: git config core.hooksPath .githooks
#
# The command list lives in the root Makefile so this hook and CI cannot
# drift apart. This deliberately runs `make check` (fast) rather than
# `make ci` — the latter adds Playwright E2E, which CI runs instead.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "[pre-push] running 'make check'…"
make check
echo "[pre-push] all gates green ✓"
